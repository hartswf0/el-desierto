id":"09_arcade_era_Person_in_VR_headset_holds_202607101900_mp4","pan":null,"ending":true}],"voice":[{"t":10.26,"dur":9.9,"clip":"09_arcade-era/Empty_arcade_after_hours_202607101939.mp4","file":"assets/09_arcade-era/Empty_arcade_after_hours_202607101939.mp4","in":0,"text":"Like and Subscribe!!","kw":["like","subscribe"],"ch":9},{"t":22.51,"dur":8.64,"clip":"09_arcade-era/VR_simulation_ride_amusement_park_202607101939.mp4","file":"assets/09_arcade-era/VR_simulation_ride_amusement_park_202607101939.mp4","in":0,"text":"But this was a new kind of escape, where reality itself was managed by machines.","kw":["kind","escape","where","reality","itself","managed","machines"],"ch":9},{"t":33.06,"dur":5,"clip":"09_arcade-era/Shopping_mall_atrium_at_night_202607101939.mp4","file":"assets/09_arcade-era/Shopping_mall_atrium_at_night_202607101939.mp4","in":0,"text":"In 1991, we were promised a new kind of escape.","kw":["promised","kind","escape"],"ch":9},{"t":38.97,"dur":5,"clip":"09_arcade-era/Virtuality_pods_in_hallway_202607101939.mp4","file":"assets/09_arcade-era/Virtuality_pods_in_hallway_202607101939.mp4","in":0,"text":"In 1991, we were promised an escape from the complexities of the real world.","kw":["promised","escape","complexities","real","world"],"ch":9},{"t":45.64,"dur":7.28,"clip":"09_arcade-era/AI_historical_reconstruction_VHS…_202607101900.mp4","file":"assets/09_arcade-era/AI_historical_reconstruction_VHS…_202607101900.mp4","in":0,"text":"They promised they escaped from reality, but they were trapped in a private world.","kw":["promised","escaped","reality","trapped","private","world"],"ch":9},{"t":53.87,"dur":3.36,"clip":"09_arcade-era/Person_in_VR_headset_holds_202607101900.mp4","file":"assets/09_arcade-era/Person_in_VR_headset_holds_202607101900.mp4","in":3.64,"text":"It promised an escape from banal reality.","kw":["promised","escape","banal","reality"],"ch":9},{"t":59.72,"dur":5,"clip":"09_arcade-era/Teenager's_face_emerging_VR_headset_202607101939.mp4","file":"assets/09_arcade-era/Teenager's_face_emerging_VR_headset_202607101939.mp4","in":0,"text":"In 1991, we believed we were on the brink of a new reality.","kw":["believed","brink","reality"],"ch":9},{"t":66.33,"dur":6,"clip":"09_arcade-era/Crowded_mall_with_VR_pods_202607101939.mp4","file":"assets/09_arcade-era/Crowded_mall_with_VR_pods_202607101939.mp4","in":3.88,"text":"But behind the promise of new worlds lay a strange new kind of isolation.","kw":["behind","promise","worlds","strange","kind","isolation"],"ch":9},{"t":74.06,"dur":5,"clip":"09_arcade-era/Arcade_players_laugh_and_shout_202607101900.mp4","file":"assets/09_arcade-era/Arcade_players_laugh_and_shout_202607101900.mp4","in":0,"text":"Whoa, where'd he go? Turn to your right! He is right behind you!","kw":["whoa","where","turn","your","right","behind"],"ch":9},{"t":81.03,"dur":7,"clip":"09_arcade-era/AI-generated_historical_reconstr…_202607101900_2.mp4","file":"assets/09_arcade-era/AI-generated_historical_reconstr…_202607101900_2.mp4","in":0,"text":"Wow, look at that! He has no idea where he is right now.","kw":["look","idea","where","right"],"ch":9},{"t":90.89,"dur":4,"clip":"09_arcade-era/Teenager's_face_emerging_VR_headset_202607101939.mp4","file":"assets/09_arcade-era/Teenager's_face_emerging_VR_headset_202607101939.mp4","in":4.88,"text":"A world where we could escape the confines of our own bodies.","kw":["world","where","could","escape","confines","bodies"],"ch":9},{"t":98.34,"dur":4,"clip":"09_arcade-era/Crowded_mall_with_VR_pods_202607101939.mp4","file":"assets/09_arcade-era/Crowded_mall_with_VR_pods_202607101939.mp4","in":0,"text":"In 1991, a new kind of escape arrived.","kw":["kind","escape","arrived"],"ch":9},{"t":104.18,"dur":3,"clip":"09_arcade-era/Man_operating_complex_machine_202607101900.mp4","file":"assets/09_arcade-era/Man_operating_complex_machine_202607101900.mp4","in":0,"text":"In 1991, we were promised a new escape.","kw":["promised","escape"],"ch":9},{"t":113.07,"dur":5,"clip":"09_arcade-era/Virtuality_pods_in_hallway_202607101939.mp4","file":"assets/09_arcade-era/Virtuality_pods_in_hallway_202607101939.mp4","in":4.88,"text":"But lines between the real and simulated were beginning to blur.","kw":["lines","between","real","simulated","beginning","blur"],"ch":9},{"t":121.44,"dur":3,"clip":"09_arcade-era/AI_generated_historical_reconstr…_202607101900.mp4","file":"assets/09_arcade-era/AI_generated_historical_reconstr…_202607101900.mp4","in":5.88,"text":"almost as if the real world was fading.","kw":["almost","real","world","fading"],"ch":9},{"t":126.73,"dur":3,"clip":"09_arcade-era/Man_operating_complex_machine_202607101900.mp4","file":"assets/09_arcade-era/Man_operating_complex_machine_202607101900.mp4","in":6.88,"text":"leaving us alone in a private world.","kw":["leaving","alone","private","world"],"ch":9},{"t":132.14,"dur":2.28,"clip":"09_arcade-era/Archival_footage_dark_nightclub_VR_202607101939.mp4","file":"assets/09_arcade-era/Archival_footage_dark_nightclub_VR_202607101939.mp4","in":6.88,"text":"into a perfect, glowing digital world.","kw":["perfect","glowing","digital","world"],"ch":9},{"t":138.77,"dur":3.76,"clip":"09_arcade-era/Person_in_VR_headset_holds_202607101900.mp4","file":"assets/09_arcade-era/Person_in_VR_headset_holds_202607101900.mp4","in":0,"text":"In 1991, virtual reality arrived.","kw":["virtual","reality","arrived"],"ch":9}],"duck":[[0,10.01,0.55],[10.26,20.41,0.28],[22.51,31.4,0.28],[33.06,38.31,0.28],[38.97,44.22,0.28],[45.64,53.17,0.28],[53.87,57.48,0.28],[59.72,64.97,0.28],[66.33,72.58,0.28],[74.06,79.31,0.28],[81.03,88.28,0.28],[90.89,95.14,0.28],[98.34,102.59,0.28],[104.18,107.43,0.28],[113.07,118.32,0.28],[121.44,124.69,0.28],[126.73,129.98,0.28],[132.14,134.67,0.28],[138.77,142.78,0.28]],"coverage":0.78,"used":32,"pool":41,"speech":0.628,"eras":[9],"filmName":"SWEEP 51 FILM ch9"}