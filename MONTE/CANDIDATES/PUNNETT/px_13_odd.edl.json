1943.mp4","in":0.5,"policy":"ACTUALITY","ch":13,"func":"human","status":"speculative","still":false,"pid":"13_open_standard_People_collaborating_in_maker_space_202607101943_mp4","pan":null},{"t":154.85999999999999,"len":3.18,"kind":"shot","clip":"13_open-standard/Documentary_video_decentralized_…_202607101943.mp4","file":"assets/13_open-standard/Documentary_video_decentralized_…_202607101943.mp4","in":6.15,"policy":"MUTE","ch":13,"func":"canonical","status":"speculative","still":false,"pid":"13_open_standard_Documentary_video_decentralized_202607101943_mp4","pan":null}],"voice":[{"t":8.64,"dur":9,"clip":"01_3d-golden/Lion_leaps_toward_camera_202607101843.mp4","file":"assets/01_3d-golden/Lion_leaps_toward_camera_202607101843.mp4","in":0,"text":"We believed we could impose our own order on the world, but we forgot that some forces can never be contained.","kw":["believed","could","impose","order","world","forgot","some","forces"],"ch":1},{"t":31.21,"dur":9,"clip":"03_sensorama/Close-up_archival_footage_advert…_202607101922.mp4","file":"assets/03_sensorama/Close-up_archival_footage_advert…_202607101922.mp4","in":0,"text":"In 1962 a new world was promised where technology would simulate reality itself.","kw":["world","promised","where","technology","would","simulate","reality","itself"],"ch":3},{"t":53.31,"dur":6,"clip":"05_damocles/Test_subject_beneath_mechanical_arm_202607101926.mp4","file":"assets/05_damocles/Test_subject_beneath_mechanical_arm_202607101926.mp4","in":3.88,"text":"They wanted to map the human mind, to connect the brain directly to a digital world.","kw":["wanted","human","mind","connect","brain","directly","digital","world"],"ch":5},{"t":76.25,"dur":10,"clip":"07_nasa-view/Operator_wearing_VIEW_headset_202607101936.mp4","file":"assets/07_nasa-view/Operator_wearing_VIEW_headset_202607101936.mp4","in":0,"text":"In the 1980s we began to build a new world but we did not realize that it would leave us completely alone.","kw":["began","build","world","reali