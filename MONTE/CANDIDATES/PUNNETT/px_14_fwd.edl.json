4_vision-pro/Empty_room_digital_interface_win…_202607101944.mp4","file":"assets/14_vision-pro/Empty_room_digital_interface_win…_202607101944.mp4","in":0.07,"policy":"MUTE","ch":14,"func":"human","status":"documented","still":false,"pid":"14_vision_pro_Empty_room_digital_interface_win_202607101944_mp4","pan":null},{"t":221.05,"len":6.32,"kind":"shot","clip":"14_vision-pro/Spatial_interface_demonstration_…_202607101944.mp4","file":"assets/14_vision-pro/Spatial_interface_demonstration_…_202607101944.mp4","in":0.23,"policy":"MUTE","ch":14,"func":"human","status":"documented","still":false,"pid":"14_vision_pro_Spatial_interface_demonstration_202607101944_mp4","pan":null,"ending":true}],"voice":[{"t":6.41,"dur":9,"clip":"01_3d-golden/Lion_leaps_toward_camera_202607101843.mp4","file":"assets/01_3d-golden/Lion_leaps_toward_camera_202607101843.mp4","in":0,"text":"We believed we could impose our own order on the world, but we forgot that some forces can never be contained.","kw":["believed","could","impose","order","world","forgot","some","forces"],"ch":1},{"t":23.96,"dur":6,"clip":"02_telesphere/Presenter_demonstrating_portable…_202607101849.mp4","file":"assets/02_telesphere/Presenter_demonstrating_portable…_202607101849.mp4","in":3.88,"text":"This is your own private theater, a truly personal cinema experience.","kw":["your","private","theater","truly","personal","cinema","experience"],"ch":2},{"t":38.27,"dur":6.6,"clip":"03_sensorama/AI_historical_reconstruction_Sen…_202607101851.mp4","file":"assets/03_sensorama/AI_historical_reconstruction_Sen…_202607101851.mp4","in":0,"text":"The Censorama offers a fully integrated experience, with simulated wind and aroma to enhance the illusion.","kw":["censorama","offers","fully","integrated","experience","simulated","wind","aroma"],"ch":3},{"t":55.91,"dur":10,"clip":"04_ultimate-display/Early_computer_graphics_wirefram…_202607101924.mp4","file":"assets/04_ultimate-display/Early_computer_graphics_wirefram…_202607101924.mp4","in":0,"text":"In the 1960s, a small group of engineers began to believe that they could contain the chaos of the world.","kw":["small","group","engineers","began","believe","could","contain","chaos"],"ch":4},{"t":72.91,"dur":6,"clip":"05_damocles/Test_subject_beneath_mechanical_arm_202607101926.mp4","file":"assets/05_damocles/Test_subject_beneath_mechanical_arm_202607101926.mp4","in":3.88,"text":"They wanted to map the human mind, to connect the brain directly to a digital world.","kw":["wanted","human","mind","connect","brain","directly","digital","world"],"ch":5},{"t":87.21,"dur":7,"clip":"06_public-grid/Computer_terminals_in_municipal_…_202607101928.mp4","file":"assets/06_public-grid/Computer_terminals_in_municipal_…_202607101928.mp4","in":0,"text":"In 1972, a new experiment began to connect ordinary people to a vast network of data.","kw":["experiment","began","connect","ordinary","people","vast","network","data"],"ch":6},{"t":103.65,"dur":10,"clip":"07_nasa-view/Operator_wearing_VIEW_headset_202607101936.mp4","file":"assets/07_nasa-view/Operator_wearing_VIEW_headset_202607101936.mp4","in":0,"text":"In the 1980s we began to build a new world but we did not realize that it would leave us completely alone.","kw":["began","build","world","realize","would","leave","completely","alone"],"ch":7},{"t":120.65,"dur":7,"clip":"08_vpl/People_wearing_HMDs_DataGloves_202607101938.mp4","file":"assets/08_vpl/People_wearing_HMDs_DataGloves_202607101938.mp4","in":0,"text":"In 1987, scientists believed they could create a new world, a shared space beyond physical reality.","kw":["scientists","believed","could","create","world","shared","space","beyond"],"ch":8},{"t":136.81,"dur":7.28,"clip":"09_arcade-era/AI_historical_reconstruction_VHS…_202607101900.mp4","file":"assets/09_arcade-era/AI_historical_reconstruction_VHS…_202607101900.mp4","in":0,"text":"They promised they escaped from reality, but they were trapped in a private world.","kw":["promised","escaped","reality","trapped","private","world"],"ch":9},{"t":152.04,"dur":9,"clip":"10_vr-winter/Hand_marking_liquidation_report_202607101941.mp4","file":"assets/10_vr-winter/Hand_marking_liquidation_report_202607101941.mp4","in":0,"text":"But the vision of a new reality was quickly deleted by the cold, hard logic of the balance sheet.","kw":["vision","reality","quickly","deleted","cold","hard","logic","balance"],"ch":10},{"t":169.51,"dur":9,"clip":"11_oculus/AI-generated_reconstruction_empt…_202607101902.mp4","file":"assets/11_oculus/AI-generated_reconstruction_empt…_202607101902.mp4","in":0,"text":"It was a new kind of collective power, but it would soon lead to a strange form of control.","kw":["kind","collective","power","would","soon","lead","strange","form"],"ch":11},{"t":184.74,"dur":7.68,"clip":"12_consumer-vr/Person_wearing_VR_headset_hits_202607101942.mp4","file":"assets/12_consumer-vr/Person_wearing_VR_headset_hits_202607101942.mp4","in":0,"text":"But this was a fantasy where the real world would soon intervene.","kw":["fantasy","where","real","world","would","soon","intervene"],"ch":12},{"t":202.11,"dur":7,"clip":"13_open-standard/Hands_passing_VR_trackers_202607101943.mp4","file":"assets/13_open-standard/Hands_passing_VR_trackers_202607101943.mp4","in":2.88,"text":"A retreat from the giant systems into a world they could build together.","kw":["retreat","giant","systems","world","could","build","together"],"ch":13},{"t":217.99,"dur":8,"clip":"14_vision-pro/Spatial_interface_demonstration_…_202607101944.mp4","file":"assets/14_vision-pro/Spatial_interface_demonstration_…_202607101944.mp4","in":0,"text":"This is the simplified world, where everything is tracked and perfectly connected.","kw":["simplified","world","where","everything","tracked","perfectly","connected"],"ch":14}],"duck":[[0,5.68,0.55],[6.41,15.66,0.28],[16.24,21.92,0.55],[21.92,23.96,0.55],[23.96,30.21,0.28],[30.09,32.48,0.55],[32.48,38.16,0.55],[38.27,45.12,0.28],[48.72,54.4,0.55],[55.91,66.16,0.28],[64.96,70.64,0.55],[72.91,79