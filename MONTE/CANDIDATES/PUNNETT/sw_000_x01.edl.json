dur":4,"clip":"03_sensorama/Inventor's_workshop_demonstratio…_202607101851.mp4","file":"assets/03_sensorama/Inventor's_workshop_demonstratio…_202607101851.mp4","in":0,"text":"In the pursuit of precision, component must work in harmony.","kw":["pursuit","precision","component","must","work","harmony"],"ch":3},{"t":16.07,"dur":4.08,"clip":"04_ultimate-display/AI_lecturer_demonstrates_wirefra…_202607101853.mp4","file":"assets/04_ultimate-display/AI_lecturer_demonstrates_wirefra…_202607101853.mp4","in":0,"text":"Here we have the precise digital representation.","kw":["here","have","precise","digital","representation"],"ch":4},{"t":20.81,"dur":4,"clip":"05_damocles/Scientist_presents_wireframe_cub…_202607101854.mp4","file":"assets/05_damocles/Scientist_presents_wireframe_cub…_202607101854.mp4","in":0,"text":"We have successfully generated direct synthetic graphics.","kw":["have","successfully","generated","direct","synthetic","graphics"],"ch":5},{"t":25.91,"dur":3,"clip":"06_public-grid/Person_talking_to_studio_camera_202607101928.mp4","file":"assets/06_public-grid/Person_talking_to_studio_camera_202607101928.mp4","in":0,"text":"This was the moment when the old illusions began to collapse.","kw":["moment","when","illusions","began","collapse"],"ch":6},{"t":30.56,"dur":4,"clip":"07_nasa-view/Military_simulation_room_calibra…_202607101936.mp4","file":"assets/07_nasa-view/Military_simulation_room_calibra…_202607101936.mp4","in":0,"text":"This was the moment where humans began to slip away.","kw":["moment","where","humans","began","slip","away"],"ch":7},{"t":35.76,"dur":3,"clip":"08_vpl/AI_presenter_promising_liberatio…_202607101859.mp4","file":"assets/08_vpl/AI_presenter_promising_liberatio…_202607101859.mp4","in":4.12,"text":"and we will float in a digital void.","kw":["will","float","digital","void"],"ch":8},{"t":40.4,"dur":3.14,"clip":"09_arcade-era/Reporter_describes_virtual_reali…_202607101900.mp4","file":"assets/09_arcade-era/Reporter_describes_virtual_reali…_20260710