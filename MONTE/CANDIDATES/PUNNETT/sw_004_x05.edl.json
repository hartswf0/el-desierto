ot.mp4","file":"BOOTS/ch14_07_screen_boot.mp4","in":0,"policy":"BOOT","ch":14,"func":"TITLE","status":"interstitial","still":false,"pid":"boot_ch14_07_screen_boot","pan":null,"boot":true},{"t":120.01,"len":5.84,"kind":"shot","clip":"14_vision-pro/Empty_room_digital_interface_win…_202607101944.mp4","file":"assets/14_vision-pro/Empty_room_digital_interface_win…_202607101944.mp4","in":3.96,"policy":"MUTE","ch":14,"func":"human","status":"documented","still":false,"pid":"14_vision_pro_Empty_room_digital_interface_win_202607101944_mp4","pan":null}],"voice":[{"t":3.62,"dur":5,"clip":"01_3d-golden/Crowd_entering_movie_palace_theater_202607101842.mp4","file":"assets/01_3d-golden/Crowd_entering_movie_palace_theater_202607101842.mp4","in":0,"text":"In 1952, a new kind of illusion was sold to the masses.","kw":["kind","illusion","sold","masses"],"ch":1},{"t":12.29,"dur":4.76,"clip":"02_telesphere/Presenter_demonstrates_cinema_he…_202607101850.mp4","file":"assets/02_telesphere/Presenter_demonstrates_cinema_he…_202607101850.mp4","in":3.12,"text":"Notice the dual eyepieces for individual viewing, a private theater that travels everywhere with you.","kw":["notice","dual","eyepieces","individual","viewing","private","theater","travels"],"ch":2},{"t":21.28,"dur":6.6,"clip":"03_sensorama/AI_historical_reconstruction_Sen…_202607101851.mp4","file":"assets/03_sensorama/AI_historical_reconstruction_Sen…_202607101851.mp4","in":0,"text":"The Censorama offers a fully integrated experience, with simulated wind and aroma to enhance the illusion.","kw":["censorama","offers","fully","integrated","experience","simulated","wind","aroma"],"ch":3},{"t":30.27,"dur":6,"clip":"04_ultimate-display/Television_weather_map_graphics_202607101924.mp4","file":"assets/04_ultimate-display/Television_weather_map_graphics_202607101924.mp4","in":0,"text":"This was the moment when we began to believe that the entire world could be managed by data.","kw":["moment","when","began","believe","entire","world","could","managed"],"ch":4},{"t":39.26,"dur":6,"clip":"05_damocles/Test_subject_beneath_mechanical_arm_202607101926.mp4","file":"assets/05_damocles/Test_subject_beneath_mechanical_arm_202607101926.mp4","in":3.88,"text":"They wanted to map the human mind, to connect the brain directly to a digital world.","kw":["wanted","human","mind","connect","brain","directly","digital","world"],"ch":5},{"t":48.25,"dur":7,"clip":"06_public-grid/Computer_terminals_in_municipal_…_202607101928.mp4","file":"assets/06_public-grid/Computer_terminals_in_municipal_…_202607101928.mp4","in":0,"text":"In 1972, a new experiment began to connect ordinary people to a vast network of data.","kw":["experiment","began","connect","ordinary","people","vast","network","data"],"ch":6},{"t":57.24,"dur":4,"clip":"07_nasa-view/Military_simulation_room_calibra…_202607101936.mp4","file":"assets/07_nasa-view/Military_simulation_room_calibra…_202607101936.mp4","in":5.88,"text":"They were simply waiting to be told what to do by cold data.","kw":["simply","waiting","told","what","cold","data"],"ch":7},{"t":66.23,"dur":7,"clip":"08_vpl/People_wearing_HMDs_DataGloves_202607101938.mp4","file":"assets/08_vpl/People_wearing_HMDs_DataGloves_202607101938.mp4","in":0,"text":"In 1987, scientists believed they could create a new world, a shared space beyond physical reality.","kw":["scientists","believed","could","create","world","shared","space","beyond"],"ch":8},{"t":75.22,"dur":7.28,"clip":"09_arcade-era/AI_historical_reconstruction_VHS…_202607101900.mp4","file":"assets/09_arcade-era/AI_historical_reconstruction_VHS…_202607101900.mp4","in":0,"text":"They promised they escaped from reality, but they were trapped in a private world.","kw":["promised","escaped","reality","trapped","private","world"],"ch":9},{"t":84.89,"dur":6,"clip":"10_vr-winter/AI_historical_reconstruction_1995_202607101901.mp4","file":"assets/10_vr-winter/AI_historical_reconstruction_1995_202607101901.mp4","in":2.88,"text":"In reality, we were moving into a world where everyone would be perfectly isolated.","kw":["reality","moving","world","where","everyone","would","perfectly","isolated"],"ch":10},{"t":93.25,"dur":5.6,"clip":"11_oculus/VR_prototype_headset_duct_tape_202607101941.mp4","file":"assets/11_oculus/VR_prototype_headset_duct_tape_202607101941.mp4","in":4.12,"text":"A way to escape into a world where reality itself was perfectly controlled.","kw":["escape","world","where","reality","itself","perfectly","controlled"],"ch":11},{"t":102.63,"dur":5,"clip":"12_consumer-vr/Person_stumbling_on_VR_cable_202607101942.mp4","file":"assets/12_consumer-vr/Person_stumbling_on_VR_cable_202607101942.mp4","in":0,"text":"But this was an illusion. We believed that we could escape into a new world.","kw":["illusion","believed","could","escape","world"],"ch":12},{"t":111.17,"dur":5,"clip":"13_open-standard/Participant_speaking_at_workshop_202607101943.mp4","file":"assets/13_open-standard/Participant_speaking_at_workshop_202607101943.mp4","in":0,"text":"In 2019, they believed they could fix the system.","kw":["believed","could","system"],"ch":13},{"t":120.16,"dur":7.44,"clip":"14_vision-pro/Employee_fits_headset_on_customer_202607101944.mp4","file":"assets/14_vision-pro/Employee_fits_headset_on_customer_202607101944.mp4","in":0,"text":"But this was an illusion, almost managed by a new kind of clinical corporate power.","kw":["illusion","almost","managed","kind","clinical","corporate","power"],"ch":14}],"duck":[[0,3.15,0.55],[3.62,8.87,0.28],[8.99,12.14,0.55],[12.29,17.3,0.28],[17.98,21.13,0.55],[21.28,28.13,0.28],[26.97,30.12,0.55],[30.27,36.52,0.28],[35.96,39.11,0.55],[39.26,45.51,0.28],[44.95,48.1,0.55],[48.25,55.5,0.28],[53.94,57.09,0.55],[57.24,61.49,0.28],[62.93,66.08,0.55],[66.23,73.48,0.28],[71.92,75.07,0.55],[75.22,82.75,0.28],[80.9,84.05,0.55],[84.89,91.14,0.28],[89.89,93.04,0.55],[93.25,99.1,0.28],[98.88,102.03,0.55],[102.63,107.88,0.28],[107.87,111.02,0.55],[111.17,116.42,0.28],[116.86,120.01,0.55],[120.16,127.85,0.28]],"c