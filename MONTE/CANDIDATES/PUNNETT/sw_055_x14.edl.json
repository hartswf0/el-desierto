":"BOOTS/act1_01_act_i_opening_sequence.mp4","in":0,"policy":"BOOT","ch":1,"func":"TITLE","status":"interstitial","still":false,"pid":"boot_act1_01_act_i_opening_sequence","pan":null,"boot":true},{"t":216.81,"len":4.24,"kind":"shot","clip":"01_3d-golden/Military_personnel_using_optical…_202607101842.mp4","file":"assets/01_3d-golden/Military_personnel_using_optical…_202607101842.mp4","in":0.31,"policy":"MUTE","ch":1,"func":"institution","status":"documented","still":false,"pid":"01_3d_golden_Military_personnel_using_optical_202607101842_mp4","pan":null},{"t":221.05,"len":6.32,"kind":"shot","clip":"01_3d-golden/Lion_leaps_toward_camera_202607101843.mp4","file":"assets/01_3d-golden/Lion_leaps_toward_camera_202607101843.mp4","in":0.75,"policy":"MUTE","ch":1,"func":"periphery","status":"documented","still":false,"pid":"01_3d_golden_Lion_leaps_toward_camera_202607101843_mp4","pan":null,"ending":true}],"voice":[{"t":6.41,"dur":7.44,"clip":"14_vision-pro/Employee_fits_headset_on_customer_202607101944.mp4","file":"assets/14_vision-pro/Employee_fits_headset_on_customer_202607101944.mp4","in":0,"text":"But this was an illusion, almost managed by a new kind of clinical corporate power.","kw":["illusion","almost","managed","kind","clinical","corporate","power"],"ch":14},{"t":23.96,"dur":5,"clip":"13_open-standard/Participant_speaking_at_workshop_202607101943.mp4","file":"assets/13_open-standard/Participant_speaking_at_workshop_202607101943.mp4","in":4.88,"text":"But the code had already begun to rewrite power.","kw":["code","already","begun","rewrite","power"],"ch":13},{"t":38.27,"dur":7,"clip":"12_consumer-vr/Hand_reaching_invisible_control_…_202607101903.mp4","file":"assets/12_consumer-vr/Hand_reaching_invisible_control_…_202607101903.mp4","in":0,"text":"We began to gesture at ghosts in the air, believing we were still in control.","kw":["began","gesture","ghosts","believing","still","control"],"ch":12},{"t":55.91,"dur":9,"clip":"11_oculus/AI-generated_reconstruction_empt…_202607101902.mp4","file":"assets/11_oculus/AI-generated_reconstruction_empt…_202607101902.mp4","in":0,"text":"It was a new kind of collective power, but it would soon lead to a strange form of control.","kw":["kind","collective","power","would","soon","lead","strange","form"],"ch":11},{"t":72.91,"dur":5.6,"clip":"10_vr-winter/Presenter_unveils_VR_headset_202607101901.mp4","file":"assets/10_vr-winter/Presenter_unveils_VR_headset_202607101901.mp4","in":0,"text":"Imagine stepping completely inside your favorite video games. This is not science fiction. This is reality.","kw":["imagine","stepping","completely","inside","your","favorite","video","games"],"ch":10},{"t":87.21,"dur":8.64,"clip":"09_arcade-era/VR_simulation_ride_amusement_park_202607101939.mp4","file":"assets/09_arcade-era/VR_simulation_ride_amusement_park_202607101939.mp4","in":0,"text":"But this was a new kind of escape, where reality itself was managed by machines.","kw":["kind","escape","where","reality","itself","managed","machines"],"ch":9},{"t":103.65,"dur":7.04,"clip":"08_vpl/Tech_magazine_cover_1987_202607101938.mp4","file":"assets/08_vpl/Tech_magazine_cover_1987_202607101938.mp4","in":0,"text":"In 1987, we were promised an escape, a digital world where reality itself could be rewritten.","kw":["promised","escape","digital","world","where","reality","itself","could"],"ch":8},{"t":120.65,"dur":9,"clip":"07_nasa-view/Hand_reaching_for_wireframe_object_202607101936.mp4","file":"assets/07_nasa-view/Hand_reaching_for_wireframe_object_202607101936.mp4","in":0,"text":"In 1985, we believed we could create a world of perfect order, but the machines only showed us our own failure.","kw":["believed","could","create","world","perfect","order","machines","only"],"ch":7},{"t":136.81,"dur":5,"clip":"06_public-grid/Community_members_operate_video_…_202607101928.mp4","file":"assets/06_public-grid/Community_members_operate_video_…_202607101928.mp4","in":3.88,"text":"They believed they could use tape to create a new kind of society.","kw":["believed","could","tape","create","kind","society"],"ch":6},{"t":152.04,"dur":5.68,"clip":"05_damocles/Technicians_watching_subject_und…_202607101926.mp4","file":"assets/05_damocles/Technicians_watching_subject_und…_202607101926.mp4","in":0,"text":"But this was not just a tool for a new kind of vision.","kw":["just","tool","kind","vision"],"ch":5},{"t":169.51,"dur":9,"clip":"04_ultimate-display/Hand_drawing_wireframe_rooms_cha…_202607101924.mp4","file":"assets/04_ultimate-display/Hand_drawing_wireframe_rooms_cha…_202607101924.mp4","in":0,"text":"We began to map the world, not as it was, but as a series of cold, predictable spaces.","kw":["began","world","series","cold","predictable","spaces"],"ch":4},{"t":184.74,"dur":9,"clip":"03_sensorama/Close-up_archival_footage_advert…_202607101922.mp4","file":"assets/03_sensorama/Close-up_archival_footage_advert…_202607101922.mp4","in":0,"text":"In 1962 a new world was promised where technology would simulate reality itself.","kw":["world","promised","where","technology","would","simulate","reality","itself"],"ch":3},{"t":202.11,"dur":9.24,"clip":"02_telesphere/Mask_lowered_toward_face_202607101848.mp4","file":"assets/02_telesphere/Mask_lowered_toward_face_202607101848.mp4","in":0,"text":"But this was a new kind of dream where the machines did the feeling for us.","kw":["kind","dream","where","machines","feeling"],"ch":2},{"t":217.99,"dur":9,"clip":"01_3d-golden/Lion_leaps_toward_camera_202607101843.mp4","file":"assets/01_3d-golden/Lion_leaps_toward_camera_202607101843.mp4","in":0,"text":"We believed we could impose our own order on the world, but we forgot that some forces can never be contained.","kw":["believed","could","impose","order","world","forgot","some","forces"],"ch":1}],"duck":[[0,5.68,0.55],[6.41,14.1,0.28],[16.24,21.92,0.55],[23.96,29.21,0.28],[32.48,38.16,0.55],[38.27,45.52,0.28],[48.72,54.4,0.55],[55.91,65.16,0.28],[64.96,70.64,0.55],[72.91,78.76,0.28],[81.2,86.88,0.55],[87.21,96.1,0.28],[9