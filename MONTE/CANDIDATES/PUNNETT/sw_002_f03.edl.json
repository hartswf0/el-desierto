1.mp4","in":0.88,"policy":"MUTE","ch":3,"func":"periphery","status":"reconstruction","still":false,"pid":"03_sensorama_AI_historical_reconstruction_196_202607101851_mp4","pan":null},{"t":135.33999999999997,"len":6.3,"kind":"shot","clip":"03_sensorama/doc-page-0002.jpg","file":"assets/03_sensorama/doc-page-0002.jpg","in":0,"policy":"MUTE","ch":3,"func":"periphery","status":"documented","still":true,"pid":"","pan":{"x":0.5536216786131263,"y":2.602292248979211,"z":1.1325095917657018}}],"voice":[{"t":9.85,"dur":10,"clip":"03_sensorama/Fans_spinning_in_dark_space_202607101922.mp4","file":"assets/03_sensorama/Fans_spinning_in_dark_space_202607101922.mp4","in":0,"text":"It was a device designed to replace reality by manipulating the very air we breathe.","kw":["device","designed","replace","reality","manipulating","very","breathe"],"ch":3},{"t":21.31,"dur":9,"clip":"03_sensorama/Close-up_archival_footage_advert…_202607101922.mp4","file":"assets/03_sensorama/Close-up_archival_footage_advert…_202607101922.mp4","in":0,"text":"In 1962 a new world was promised where technology would simulate reality itself.","kw":["world","promised","where","technology","would","simulate","reality","itself"],"ch":3},{"t":33.63,"dur":5,"clip":"03_sensorama/Person_leaning_into_hood_202607101922.mp4","file":"assets/03_sensorama/Person_leaning_into_hood_202607101922.mp4","in":0,"text":"In 1962, a new kind of machine promised to simulate reality.","kw":["kind","machine","promised","simulate","reality"],"ch":3},{"t":40.16,"dur":3.92,"clip":"03_sensorama/Technical_diagrams_for_Sensorama_202607101922.mp4","file":"assets/03_sensorama/Technical_diagrams_for_Sensorama_202607101922.mp4","in":0,"text":"In 1962, an inventor patented a machine.","kw":["inventor","patented","machine"],"ch":3},{"t":45.78,"dur":2.8,"clip":"03_sensorama/AI_historical_reconstruction_Sen…_202607101851.mp4","file":"assets/03_sensorama/AI_historical_reconstruction_Sen…_202607101851.mp4","in":6.98,"text":"Thus, man and machine enter a new era.","kw":["thus","machine","enter"],"ch":3},{"t":51.67,"dur":6.6,"clip":"03_sensorama/AI_historical_reconstruction_Sen…_202607101851.mp4","file":"assets/03_sensorama/AI_historical_reconstruction_Sen…_202607101851.mp4","in":0,"text":"The Censorama offers a fully integrated experience, with simulated wind and aroma to enhance the illusion.","kw":["censorama","offers","fully","integrated","experience","simulated","wind","aroma"],"ch":3},{"t":61.34,"dur":6,"clip":"03_sensorama/AI-generated_historical_reconstr…_202607101851_2.mp4","file":"assets/03_sensorama/AI-generated_historical_reconstr…_202607101851_2.mp4","in":3.88,"text":"It simulates a fully immersive environment. Witness the future of sensory realism.","kw":["simulates","fully","immersive","environment","witness","future","sensory","realism"],"ch":3},{"t":70,"dur":2.64,"clip":"03_sensorama/AI-generated_historical_reconstr…_202607101851.mp4","file":"assets/03_sensorama/AI-generated_historical_reconstr…_202607101851.mp4","in":0,"text":"Step right up and experience the future!","kw":["step","right","experience","future"],"ch":3},{"t":75.65,"dur":2.24,"clip":"03_sensorama/AI_historical_reconstruction_mot…_202607101851.mp4","file":"assets/03_sensorama/AI_historical_reconstruction_mot…_202607101851.mp4","in":0,"text":"Step right up and experience the future.","kw":["step","right","experience","future"],"ch":3},{"t":81.86,"dur":5.08,"clip":"03_sensorama/Amusement_arcade_at_night_202607101922.mp4","file":"assets/03_sensorama/Amusement_arcade_at_night_202607101922.mp4","in":10.4,"text":"More versioning delay.","kw":["more","versioning","delay"],"ch":3},{"t":89.38,"dur":4,"clip":"03_sensorama/AI-generated_historical_reconstr…_202607101851_2.mp4","file":"assets/03_sensorama/AI-generated_historical_reconstr…_202607101851_2.mp4","in":0,"text":"This is the Sensorama, a revolution in cinematography.","kw":["sensorama","revolution","cinematography"],"ch":3},{"t":94.58,"dur":2.72,"clip":"03_sensorama/AI-generated_historical_reconstr…_202607101851.mp4","file":"assets/03_sensorama/AI-generated_historical_reconstr…_202607101851.mp4","in":2.52,"text":"The Sensorama will fully immerse your senses.","kw":["sensorama","will","fully","immerse","your","senses"],"ch":3},{"t":100.13,"dur":2.4,"clip":"03_sensorama/AI_historical_reconstruction_mot…_202607101851.mp4","file":"assets/03_sensorama/AI_historical_reconstruction_mot…_202607101851.mp4","in":2.12,"text":"Just insert a coin to begin your journey.","kw":["just","insert","coin","begin","your","journey"],"ch":3},{"t":104.97,"dur":3.12,"clip":"03_sensorama/AI-generated_historical_reconstr…_202607101851.mp4","file":"assets/03_sensorama/AI-generated_historical_reconstr…_202607101851.mp4","in":5.24,"text":"Just one thin dime opens up a whole new world.","kw":["just","thin","dime","opens","whole","world"],"ch":3},{"t":109.22,"dur":4,"clip":"03_sensorama/Inventor's_workshop_demonstratio…_202607101851.mp4","file":"assets/03_sensorama/Inventor's_workshop_demonstratio…_202607101851.mp4","in":0,"text":"In the pursuit of precision, component must work in harmony.","kw":["pursuit","precision","component","must","work","harmony"],"ch":3},{"t":115.53,"dur":4.2,"clip":"03_sensorama/Person_leaning_into_hood_202607101922.mp4","file":"assets/03_sensorama/Person_leaning_into_hood_202607101922.mp4","in":5.68,"text":"But it was all an illusion, designed to control us.","kw":["illusion","designed","control"],"ch":3},{"t":121.97,"dur":3,"clip":"03_sensorama/Inventor's_workshop_demonstratio…_202607101851.mp4","file":"assets/03_sensorama/Inventor's_workshop_demonstratio…_202607101851.mp4","in":6.88,"text":"This is the foundation of tomorrow's industry.","kw":["foundation","tomorrow","industry"],"ch":3},{"t":126.27,"dur":3.28,"clip":"03_sensorama/Technical_diagrams_for_Sensorama_202607101922.mp4","file":"assets/03_sensorama/Technical_diagrams_for_Sensorama_202607101922.mp4","in":6.6,"text":"by feeding sensations directly to the nervous system.","kw":["feeding","sensa