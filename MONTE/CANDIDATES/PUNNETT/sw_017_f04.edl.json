dback_…_202607101924.mp4","in":4.46,"policy":"MUTE","ch":4,"func":"human","status":"documented","still":false,"pid":"04_ultimate_display_Diagrams_showing_human_feedback_202607101924_mp4","pan":null},{"t":167.59,"len":3.49,"kind":"shot","clip":"04_ultimate-display/AI_lecturer_demonstrates_wirefra…_202607101853.mp4","file":"assets/04_ultimate-display/AI_lecturer_demonstrates_wirefra…_202607101853.mp4","in":6.52,"policy":"SYNC","ch":4,"func":"human","status":"documented","still":false,"pid":"04_ultimate_display_AI_lecturer_demonstrates_wirefra_202607101853_mp4","pan":null},{"t":171.08,"len":1.12,"kind":"shot","clip":"04_ultimate-display/sketchpad_original_display_image.png_202607101924.jpeg","file":"assets/04_ultimate-display/sketchpad_original_display_image.png_202607101924.jpeg","in":0,"policy":"MUTE","ch":4,"func":"periphery","status":"documented","still":true,"pid":"","pan":{"x":5.103561429306865,"y":-0.7033115606755018,"z":1.1081785597279667}}],"voice":[{"t":10.26,"dur":10,"clip":"04_ultimate-display/Early_computer_graphics_wirefram…_202607101924.mp4","file":"assets/04_ultimate-display/Early_computer_graphics_wirefram…_202607101924.mp4","in":0,"text":"In the 1960s, a small group of engineers began to believe that they could contain the chaos of the world.","kw":["small","group","engineers","began","believe","could","contain","chaos"],"ch":4},{"t":21.91,"dur":6,"clip":"04_ultimate-display/Television_weather_map_graphics_202607101924.mp4","file":"assets/04_ultimate-display/Television_weather_map_graphics_202607101924.mp4","in":0,"text":"This was the moment when we began to believe that the entire world could be managed by data.","kw":["moment","when","began","believe","entire","world","could","managed"],"ch":4},{"t":34.99,"dur":9,"clip":"04_ultimate-display/Hand_drawing_wireframe_rooms_cha…_202607101924.mp4","file":"assets/04_ultimate-display/Hand_drawing_wireframe_rooms_cha…_202607101924.mp4","in":0,"text":"We began to map the world, not as it was, but as a series of cold, predictable spaces.","kw":["began","world","series","cold","predictable","spaces"],"ch":4},{"t":48.63,"dur":9,"clip":"04_ultimate-display/Computer_monitor_displaying_text_202607101924.mp4","file":"assets/04_ultimate-display/Computer_monitor_displaying_text_202607101924.mp4","in":0,"text":"This was the beginning of a world purely defined by the screen.","kw":["beginning","world","purely","defined","screen"],"ch":4},{"t":58.73,"dur":4.32,"clip":"04_ultimate-display/Researcher_using_primitive_compu…_202607101924.mp4","file":"assets/04_ultimate-display/Researcher_using_primitive_compu…_202607101924.mp4","in":0,"text":"In the 1960s, a new vision emerged to manage the world through machines.","kw":["vision","emerged","manage","world","through","machines"],"ch":4},{"t":65.46,"dur":7,"clip":"04_ultimate-display/AI-generated_historical_reconstr…_202607101853_2.mp4","file":"assets/04_ultimate-display/AI-generated_historical_reconstr…_202607101853_2.mp4","in":0,"text":"By 1965 we believed everything could be captured.","kw":["believed","everything","could","captured"],"ch":4},{"t":74.67,"dur":4,"clip":"04_ultimate-display/Workers_remove_tables_chairs_room_202607101853.mp4","file":"assets/04_ultimate-display/Workers_remove_tables_chairs_room_202607101853.mp4","in":4.88,"text":"where everything would be held forever in a seamless void.","kw":["where","everything","would","held","forever","seamless","void"],"ch":4},{"t":80.66,"dur":4,"clip":"04_ultimate-display/Model_home_furniture_arranged_li…_202607101924.mp4","file":"assets/04_ultimate-display/Model_home_furniture_arranged_li…_202607101924.mp4","in":4.88,"text":"where nothing unexpected would ever happen again.","kw":["where","nothing","unexpected","would","ever","happen","again"],"ch":4},{"t":88.86,"dur":7,"clip":"04_ultimate-display/Hand_removing_wooden_chair_202607101924.mp4","file":"assets/04_ultimate-display/Hand_removing_wooden_chair_202607101924.mp4","in":0,"text":"But this was an illusion managed by the cold mechanics of the state.","kw":["illusion","managed","cold","mechanics","state"],"ch":4},{"t":97.26,"dur":4.88,"clip":"04_ultimate-display/Researcher_using_primitive_compu…_202607101924.mp4","file":"assets/04_ultimate-display/Researcher_using_primitive_compu…_202607101924.mp4","in":4.84,"text":"But this cold logic contained a fatal flaw. It forgot the complexity of human feeling.","kw":["cold","logic","contained","fatal","flaw","forgot","complexity","human"],"ch":4},{"t":109.85,"dur":4,"clip":"04_ultimate-display/Television_weather_map_graphics_202607101924.mp4","file":"assets/04_ultimate-display/Television_weather_map_graphics_202607101924.mp4","in":5.88,"text":"A neat, predictable system of cold glass and cables.","kw":["neat","predictable","system","cold","glass","cables"],"ch":4},{"t":115.73,"dur":3,"clip":"04_ultimate-display/1960s_university_computer_center_202607101924.mp4","file":"assets/04_ultimate-display/1960s_university_computer_center_202607101924.mp4","in":6.88,"text":"leaving us trapped in a system we did not understand.","kw":["leaving","trapped","system","understand"],"ch":4},{"t":120.18,"dur":7,"clip":"04_ultimate-display/AI_computer_lab_reconstruction_202607101853.mp4","file":"assets/04_ultimate-display/AI_computer_lab_reconstruction_202607101853.mp4","in":0,"text":"The link is transmitting to UCLA. Let's check the host interface.","kw":["link","transmitting","ucla","check","host","interface"],"ch":4},{"t":130.15,"dur":5,"clip":"04_ultimate-display/AI_reconstruction_1965_demonstra…_202607101853.mp4","file":"assets/04_ultimate-display/AI_reconstruction_1965_demonstra…_202607101853.mp4","in":0,"text":"The modern computer processes data.","kw":["modern","computer","processes","data"],"ch":4},{"t":136.83,"dur":3.6,"clip":"04_ultimate-display/Scientists_pointing_at_screen_202607101924.mp4","file":"assets/04_ultimate-display/Scientists_pointing_at_screen_202607101924.mp4","in":2.92,"text":"The data streams are stabilizing at 0.04.","kw":["data","streams","stabilizing"],"ch":4},{"t":142.2,"dur":5,"clip":"04_ultimate-display/Archival_footage_room_security_g…_202607101924.mp4","file":"assets/04_ultimate-display/Archival_footage_room_security_g…_202607101924.mp4","in":3.88,"text":"designed to track and predict the behavior of millions.","kw":["designed","track","predict","behavior","millions"],"ch":4},{"t":157,"dur":4.34,"clip":"04_ultimate-display/Academic_lecturer_demonstrates_p…_202607101853.mp4","file":"assets/04_ultimate-display/Academic_lecturer_demonstrates_p…_202607101853.mp4","in":6.82,"text":"programmable. A new world awaits.","kw":["programmable","world","awaits"],"ch":4},{"t":162.26,"dur":3.28,"clip":"04_ultimate-display/Scientists_pointing_at_screen_202607101924.mp4","file":"assets/04_ultimate-display/Scientists_pointing_at_screen_202607101924.mp4","in":6.52,"text":"Beneath the surface, the human element was fading.","kw":["beneath","surface","human","element","fading"],"ch":4},{"t":167.59,"dur":3.56,"clip":"04_ultimate-display/AI_lecturer_demonstrates_wirefra…_202607101853.mp4","file":"assets/04_ultimate-display/AI_lecturer_demonstrates_wirefra…_202607101853.mp4","in":6.52,"text":"Every point corresponds to physical space.","kw":["every","point","corresponds","physical","space"],"ch":4}],"duck":[[0,10.01,0.55],[10.26,20.51,0.28],[21.91,28.16,0.28],[34.99,44.24,0.28],[48.63,57.88,0.28],[58.73,63.3,0.28],[65.46,72.71,0.28],[74.67,78.92,0.28],[80.66,84.91,0.28],[88.86,96.11,0.28],[97.26,102.39,0.28],[109.85,114.1,0.28],[115.73,118.98,0.28],[120.18,127.43,0.28],[130.15,135.4,0.28],[136.83,140.68,0.28],[142.2,147.45,0.28],[157,161.59,0.28],[162.26,165.79,0.28],[167.59,171.4,0.28]],"coverage":0.881,"used":37,"pool":42,"speech":0.604,"eras":[4],"filmName":"SWEEP 18 FILM ch4"}