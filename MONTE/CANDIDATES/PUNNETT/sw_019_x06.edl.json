ere_Presenter_demonstrating_portable_202607101849_mp4","pan":null},{"t":126.74,"len":3.41,"kind":"shot","clip":"BOOTS/act1_03_act_i_animation.mp4","file":"BOOTS/act1_03_act_i_animation.mp4","in":0,"policy":"BOOT","ch":1,"func":"TITLE","status":"interstitial","still":false,"pid":"boot_act1_03_act_i_animation","pan":null,"boot":true},{"t":130.15,"len":6.34,"kind":"shot","clip":"01_3d-golden/Military_personnel_using_optical…_202607101842.mp4","file":"assets/01_3d-golden/Military_personnel_using_optical…_202607101842.mp4","in":2.22,"policy":"MUTE","ch":1,"func":"institution","status":"documented","still":false,"pid":"01_3d_golden_Military_personnel_using_optical_202607101842_mp4","pan":null}],"voice":[{"t":3.56,"dur":7.44,"clip":"14_vision-pro/Employee_fits_headset_on_customer_202607101944.mp4","file":"assets/14_vision-pro/Employee_fits_headset_on_customer_202607101944.mp4","in":0,"text":"But this was an illusion, almost managed by a new kind of clinical corporate power.","kw":["illusion","almost","managed","kind","clinical","corporate","power"],"ch":14},{"t":13.65,"dur":5,"clip":"13_open-standard/Participant_speaking_at_workshop_202607101943.mp4","file":"assets/13_open-standard/Participant_speaking_at_workshop_202607101943.mp4","in":4.88,"text":"But the code had already begun to rewrite power.","kw":["code","already","begun","rewrite","power"],"ch":13},{"t":23.06,"dur":7,"clip":"12_consumer-vr/Hand_reaching_invisible_control_…_202607101903.mp4","file":"assets/12_consumer-vr/Hand_reaching_invisible_control_…_202607101903.mp4","in":0,"text":"We began to gesture at ghosts in the air, believing we were still in control.","kw":["began","gesture","ghosts","believing","still","control"],"ch":12},{"t":32.81,"dur":9,"clip":"11_oculus/AI-generated_reconstruction_empt…_202607101902.mp4","file":"assets/11_oculus/AI-generated_reconstruction_empt…_202607101902.mp4","in":0,"text":"It was a new kind of collective power, but it would soon lead to a strange form of control.","kw":["kind","collective","power","would","soon","lead","strange","form"],"ch":11},{"t":42.45,"dur":5.6,"clip":"10_vr-winter/Presenter_unveils_VR_headset_202607101901.mp4","file":"assets/10_vr-winter/Presenter_unveils_VR_headset_202607101901.mp4","in":0,"text":"Imagine stepping completely inside your favorite video games. This is not science fiction. This is reality.","kw":["imagine","stepping","completely","inside","your","favorite","video","games"],"ch":10},{"t":52.2,"dur":3.14,"clip":"09_arcade-era/Reporter_describes_virtual_reali…_202607101900.mp4","file":"assets/09_arcade-era/Reporter_describes_virtual_reali…_202607101900.mp4","in":6.52,"text":"Just step inside one of these futuristic pods.","kw":["just","step","inside","these","futuristic","pods"],"ch":9},{"t":62.05,"dur":7,"clip":"08_vpl/People_wearing_HMDs_DataGloves_202607101938.mp4","file":"assets/08_vpl/People_wearing_HMDs_DataGloves_202607101938.mp4","in":0,"text":"In 1987, scientists believed they could create a new world, a shared space beyond physical reality.","kw":["scientists","believed","could","create","world","shared","space","beyond"],"ch":8},{"t":71.8,"dur":9,"clip":"07_nasa-view/Hand_reaching_for_wireframe_object_202607101936.mp4","file":"assets/07_nasa-view/Hand_reaching_for_wireframe_object_202607101936.mp4","in":0,"text":"In 1985, we believed we could create a world of perfect order, but the machines only showed us our own failure.","kw":["believed","could","create","world","perfect","order","machines","only"],"ch":7},{"t":81.55,"dur":8,"clip":"06_public-grid/Hands_passing_video_tape_202607101928.mp4","file":"assets/06_public-grid/Hands_passing_video_tape_202607101928.mp4","in":0,"text":"This was the era when we believed that capturing reality on tape would somehow set us free.","kw":["when","believed","capturing","reality","tape","would","somehow","free"],"ch":6},{"t":92.14,"dur":6,"clip":"05_damocles/Test_subject_beneath_mechanical_arm_202607101926.mp4","file":"assets/05_damocles/Test_subject_beneath_mechanical_arm_202607101926.mp4","in":3.88,"text":"They wanted to map the human mind, to connect the brain directly to a digital world.","kw":["wanted","human","mind","connect","brain","directly","digital","world"],"ch":5},{"t":101.05,"dur":9,"clip":"04_ultimate-display/Hand_drawing_wireframe_rooms_cha…_202607101924.mp4","file":"assets/04_ultimate-display/Hand_drawing_wireframe_rooms_cha…_202607101924.mp4","in":0,"text":"We began to map the world, not as it was, but as a series of cold, predictable spaces.","kw":["began","world","series","cold","predictable","spaces"],"ch":4},{"t":110.8,"dur":9,"clip":"03_sensorama/Close-up_archival_footage_advert…_202607101922.mp4","file":"assets/03_sensorama/Close-up_archival_footage_advert…_202607101922.mp4","in":0,"text":"In 1962 a new world was promised where technology would simulate reality itself.","kw":["world","promised","where","technology","would","simulate","reality","itself"],"ch":3},{"t":120.47,"dur":6,"clip":"02_telesphere/Presenter_demonstrating_portable…_202607101849.mp4","file":"assets/02_telesphere/Presenter_demonstrating_portable…_202607101849.mp4","in":3.88,"text":"This is your own private theater, a truly personal cinema experience.","kw":["your","private","theater","truly","personal","cinema","experience"],"ch":2},{"t":130.3,"dur":9,"clip":"01_3d-golden/Lion_leaps_toward_camera_202607101843.mp4","file":"assets/01_3d-golden/Lion_leaps_toward_camera_202607101843.mp4","in":0,"text":"We believed we could impose our own order on the world, but we forgot that some forces can never be contained.","kw":["believed","could","impose","order","world","forgot","some","forces"],"ch":1}],"duck":[[0,3.41,0.55],[3.56,11.25,0.28],[9.75,13.16,0.55],[13.65,18.9,0.28],[19.5,22.91,0.55],[23.06,30.31,0.28],[29.25,32.66,0.55],[32.81,42.06,0.28],[39,42.41,0.55],[42.45,48.3,0.28],[48.75,52.16,0.55],[52.2,55.59,0.28],[58.49,61.9,0.55],[62.05,69.3,0.28],[68.24,71.65,0.55],[71.8,81.05,0.28],[77.99,81.4,0.55],[81.55,89.8,0.28],[87.74,9