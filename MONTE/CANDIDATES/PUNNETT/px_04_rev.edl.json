n/Military_personnel_using_optical…_202607101842.mp4","file":"assets/01_3d-golden/Military_personnel_using_optical…_202607101842.mp4","in":1.91,"policy":"MUTE","ch":1,"func":"institution","status":"documented","still":false,"pid":"01_3d_golden_Military_personnel_using_optical_202607101842_mp4","pan":null},{"t":170.91000000000003,"len":1.29,"kind":"shot","clip":"01_3d-golden/Lion_leaps_toward_camera_202607101843.mp4","file":"assets/01_3d-golden/Lion_leaps_toward_camera_202607101843.mp4","in":4.31,"policy":"MUTE","ch":1,"func":"periphery","status":"documented","still":false,"pid":"01_3d_golden_Lion_leaps_toward_camera_202607101843_mp4","pan":null}],"voice":[{"t":4.45,"dur":7.44,"clip":"14_vision-pro/Employee_fits_headset_on_customer_202607101944.mp4","file":"assets/14_vision-pro/Employee_fits_headset_on_customer_202607101944.mp4","in":0,"text":"But this was an illusion, almost managed by a new kind of clinical corporate power.","kw":["illusion","almost","managed","kind","clinical","corporate","power"],"ch":14},{"t":16.75,"dur":5,"clip":"13_open-standard/Participant_speaking_at_workshop_202607101943.mp4","file":"assets/13_open-standard/Participant_speaking_at_workshop_202607101943.mp4","in":4.88,"text":"But the code had already begun to rewrite power.","kw":["code","already","begun","rewrite","power"],"ch":13},{"t":29.35,"dur":7.68,"clip":"12_consumer-vr/Person_wearing_VR_headset_hits_202607101942.mp4","file":"assets/12_consumer-vr/Person_wearing_VR_headset_hits_202607101942.mp4","in":0,"text":"But this was a fantasy where the real world would soon intervene.","kw":["fantasy","where","real","world","would","soon","intervene"],"ch":12},{"t":41.35,"dur":9,"clip":"11_oculus/AI-generated_reconstruction_empt…_202607101902.mp4","file":"assets/11_oculus/AI-generated_reconstruction_empt…_202607101902.mp4","in":0,"text":"It was a new kind of collective power, but it would soon lead to a strange form of control.","kw":["kind","collective","power","would","soon","lead","strange","form"],"ch":11},{"t":56.29,"dur":5.6,"clip":"10_vr-winter/Presenter_unveils_VR_headset_202607101901.mp4","file":"assets/10_vr-winter/Presenter_unveils_VR_headset_202607101901.mp4","in":0,"text":"Imagine stepping completely inside your favorite video games. This is not science fiction. This is reality.","kw":["imagine","stepping","completely","inside","your","favorite","video","games"],"ch":10},{"t":68.36,"dur":3.14,"clip":"09_arcade-era/Reporter_describes_virtual_reali…_202607101900.mp4","file":"assets/09_arcade-era/Reporter_describes_virtual_reali…_202607101900.mp4","in":6.52,"text":"Just step inside one of these futuristic pods.","kw":["just","step","inside","these","futuristic","pods"],"ch":9},{"t":78.25,"dur":7.04,"clip":"08_vpl/Tech_magazine_cover_1987_202607101938.mp4","file":"assets/08_vpl/Tech_magazine_cover_1987_202607101938.mp4","in":0,"text":"In 1987, we were promised an escape, a digital world where reality itself could be rewritten.","kw":["promised","escape","digital","world","where","reality","itself","could"],"ch":8},{"t":90.55,"dur":9,"clip":"07_nasa-view/Hand_reaching_for_wireframe_object_202607101936.mp4","file":"assets/07_nasa-view/Hand_reaching_for_wireframe_object_202607101936.mp4","in":0,"text":"In 1985, we believed we could create a world of perfect order, but the machines only showed us our own failure.","kw":["believed","could","create","world","perfect","order","machines","only"],"ch":7},{"t":104.4,"dur":5,"clip":"06_public-grid/Community_members_operate_video_…_202607101928.mp4","file":"assets/06_public-grid/Community_members_operate_video_…_202607101928.mp4","in":3.88,"text":"They believed they could use tape to create a new kind of society.","kw":["believed","could","tape","create","kind","society"],"ch":6},{"t":116.19,"dur":6,"clip":"05_damocles/Test_subject_beneath_mechanical_arm_202607101926.mp4","file":"assets/05_damocles/Test_subject_beneath_mechanical_arm_202607101926.mp4","in":3.88,"text":"They wanted to map the human mind, to connect the brain directly to a digital world.","kw":["wanted","human","mind","connect","brain","directly","digital","world"],"ch":5},{"t":127.45,"dur":9,"clip":"04_ultimate-display/Hand_drawing_wireframe_rooms_cha…_202607101924.mp4","file":"assets/04_ultimate-display/Hand_drawing_wireframe_rooms_cha…_202607101924.mp4","in":0,"text":"We began to map the world, not as it was, but as a series of cold, predictable spaces.","kw":["began","world","series","cold","predictable","spaces"],"ch":4},{"t":139.75,"dur":9,"clip":"03_sensorama/Close-up_archival_footage_advert…_202607101922.mp4","file":"assets/03_sensorama/Close-up_archival_footage_advert…_202607101922.mp4","in":0,"text":"In 1962 a new world was promised where technology would simulate reality itself.","kw":["world","promised","where","technology","would","simulate","reality","itself"],"ch":3},{"t":152.05,"dur":9.24,"clip":"02_telesphere/Mask_lowered_toward_face_202607101848.mp4","file":"assets/02_telesphere/Mask_lowered_toward_face_202607101848.mp4","in":0,"text":"But this was a new kind of dream where the machines did the feeling for us.","kw":["kind","dream","where","machines","feeling"],"ch":2},{"t":164.35,"dur":9,"clip":"01_3d-golden/Lion_leaps_toward_camera_202607101843.mp4","file":"assets/01_3d-golden/Lion_leaps_toward_camera_202607101843.mp4","in":0,"text":"We believed we could impose our own order on the world, but we forgot that some forces can never be contained.","kw":["believed","could","impose","order","world","forgot","some","forces"],"ch":1}],"duck":[[0,4.3,0.55],[4.45,12.14,0.28],[12.3,16.6,0.55],[16.75,22,0.28],[24.6,28.9,0.55],[29.35,37.28,0.28],[36.9,41.2,0.55],[41.35,50.6,0.28],[49.2,53.5,0.55],[56.29,62.14,0.28],[61.5,65.8,0.55],[68.36,71.75,0.28],[73.8,78.1,0.55],[78.25,85.54,0.28],[86.1,90.4,0.55],[90.55,99.8,0.28],[98.4,102.7,0.55],[104.4,109.65,0.28],[110.7,115,0.55],[116.19,122.44,0.28],[123,127.3,0.55],[127.45,136.7,0.28],[135.3,139.6,0.55],[139.75,149,0.28],[147.6,151.9,0.55],[152.05,161