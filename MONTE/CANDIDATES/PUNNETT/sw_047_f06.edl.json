c-grid/Urban_cybernetics_proposal_diagram_202607101928.mp4","file":"assets/06_public-grid/Urban_cybernetics_proposal_diagram_202607101928.mp4","in":0,"text":"In the 1970s, a new idea took hold, to manage the city as a pure data system.","kw":["idea","took","hold","manage","city","pure","data","system"],"ch":6},{"t":52.03,"dur":4,"clip":"06_public-grid/People_gathered_media_center_202607101928.mp4","file":"assets/06_public-grid/People_gathered_media_center_202607101928.mp4","in":0,"text":"In 1972, a new idealism took hold.","kw":["idealism","took","hold"],"ch":6},{"t":57.36,"dur":8.8,"clip":"06_public-grid/Person's_face_reflecting_television_202607101928.mp4","file":"assets/06_public-grid/Person's_face_reflecting_television_202607101928.mp4","in":0,"text":"But this was an illusion, a vast artificial dream projected directly into our minds.","kw":["illusion","vast","artificial","dream","projected","directly","minds"],"ch":6},{"t":73.83,"dur":7,"clip":"06_public-grid/Computer_terminals_in_municipal_…_202607101928.mp4","file":"assets/06_public-grid/Computer_terminals_in_municipal_…_202607101928.mp4","in":0,"text":"In 1972, a new experiment began to connect ordinary people to a vast network of data.","kw":["experiment","began","connect","ordinary","people","vast","network","data"],"ch":6},{"t":83.72,"dur":3,"clip":"06_public-grid/People_gathered_media_center_202607101928.mp4","file":"assets/06_public-grid/People_gathered_media_center_202607101928.mp4","in":5.88,"text":"Ordinary people would now control the means of media.","kw":["ordinary","people","would","control","means","media"],"ch":6},{"t":91.58,"dur":4.48,"clip":"06_public-grid/Communal_projection_event_in_park_202607101928.mp4","file":"assets/06_public-grid/Communal_projection_event_in_park_202607101928.mp4","in":5.4,"text":"Hundreds of people would gather in the darkness, drawn by the power of pure, abstract life.","kw":["hundreds","people","would","gather","darkness","drawn","power","pure"],"ch":6},{"t":98.85,"dur":8,"clip":"06_public-grid/Hands_passing_video_tape_202607101928.mp4","file":"assets/06_public-grid/Hands_passing_video_tape_202607101928.mp4","in":0,"text":"This was the era when we believed that capturing reality on tape would somehow set us free.","kw":["when","believed","capturing","reality","tape","would","somehow","free"],"ch":6},{"t":107.85,"dur":5,"clip":"06_public-grid/AI_historical_reconstruction_chi…_202607101856.mp4","file":"assets/06_public-grid/AI_historical_reconstruction_chi…_202607101856.mp4","in":0,"text":"It was a moment when we believed technology would mirror our best selves.","kw":["moment","when","believed","technology","would","mirror","best","selves"],"ch":6},{"t":118.65,"dur":3,"clip":"06_public-grid/Person_talking_to_studio_camera_202607101928.mp4","file":"assets/06_public-grid/Person_talking_to_studio_camera_202607101928.mp4","in":0,"text":"This was the moment when the old illusions began to collapse.","kw":["moment","when","illusions","began","collapse"],"ch":6},{"t":126.58,"dur":3,"clip":"06_public-grid/Person_talking_to_studio_camera_202607101928.mp4","file":"assets/06_public-grid/Person_talking_to_studio_camera_202607101928.mp4","in":6.68,"text":"human nature, and that was when the real chaos began.","kw":["human","nature","when","real","chaos","began"],"ch":6},{"t":130.47,"dur":4.2,"clip":"06_public-grid/AI_historical_reconstruction_197…_202607101856_3.mp4","file":"assets/06_public-grid/AI_historical_reconstruction_197…_202607101856_3.mp4","in":0,"text":"In 1952, a new kind of mass control was born.","kw":["kind","mass","control","born"],"ch":6}],"duck":[[0,9.7,0.55],[9.95,20.18,0.28],[24.24,26.75,0.55],[32.47,41.72,0.28],[43.17,49.1,0.28],[52.03,56.28,0.28],[57.36,66.41,0.28],[73.83,81.08,0.28],[83.72,86.97,0.28],[91.58,96.31,0.28],[98.85,107.1,0.28],[107.85,113.1,0.28],[116.66,118.65,0.55],[118.65,121.9,0.28],[126.58,129.83,0.28],[130.47,134.92,0.28]],"coverage":0.767,"used":33,"pool":43,"speech":0.551,"eras":[6],"filmName":"SWE