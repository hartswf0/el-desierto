e,"pid":"","pan":{"x":-0.8472185209393501,"y":-1.4438199270516634,"z":1.1056541452929378}},{"t":190.12,"len":3.39,"kind":"shot","clip":"07_nasa-view/NASA_DataGlove_flexing_hand_202607101936.mp4","file":"assets/07_nasa-view/NASA_DataGlove_flexing_hand_202607101936.mp4","in":5.41,"policy":"MUTE","ch":7,"func":"human","status":"documented","still":false,"pid":"07_nasa_view_NASA_DataGlove_flexing_hand_202607101936_mp4","pan":null,"ending":true}],"voice":[{"t":10.26,"dur":10,"clip":"07_nasa-view/Operator_wearing_VIEW_headset_202607101936.mp4","file":"assets/07_nasa-view/Operator_wearing_VIEW_headset_202607101936.mp4","in":0,"text":"In the 1980s we began to build a new world but we did not realize that it would leave us completely alone.","kw":["began","build","world","realize","would","leave","completely","alone"],"ch":7},{"t":23.06,"dur":5,"clip":"07_nasa-view/Researcher's_eyes_reflected_HMD_202607101936.mp4","file":"assets/07_nasa-view/Researcher's_eyes_reflected_HMD_202607101936.mp4","in":0,"text":"In 1985, we began to leave the physical world behind.","kw":["began","leave","physical","world","behind"],"ch":7},{"t":32.31,"dur":9,"clip":"07_nasa-view/Hand_reaching_for_wireframe_object_202607101936.mp4","file":"assets/07_nasa-view/Hand_reaching_for_wireframe_object_202607101936.mp4","in":0,"text":"In 1985, we believed we could create a world of perfect order, but the machines only showed us our own failure.","kw":["believed","could","create","world","perfect","order","machines","only"],"ch":7},{"t":45.46,"dur":6,"clip":"07_nasa-view/Researcher_wearing_head-mounted_…_202607101936.mp4","file":"assets/07_nasa-view/Researcher_wearing_head-mounted_…_202607101936.mp4","in":0,"text":"In 1985, we believed we could escape into the machine.","kw":["believed","could","escape","machine"],"ch":7},{"t":54.09,"dur":10,"clip":"07_nasa-view/Astronauts_telepresence_training…_202607101936.mp4","file":"assets/07_nasa-view/Astronauts_telepresence_training…_202607101936.mp4","in":0,"text":"In 1985, NASA began a new program. They called it telepresence. It was designed to remove the human entirely.","kw":["nasa","began","program","called","telepresence","designed","remove","human"],"ch":7},{"t":77.94,"dur":4.04,"clip":"07_nasa-view/Bureaucrat_giving_funding_presen…_202607101936.mp4","file":"assets/07_nasa-view/Bureaucrat_giving_funding_presen…_202607101936.mp4","in":2.56,"text":"We are defining a new form of human presence.","kw":["defining","form","human","presence"],"ch":7},{"t":85.05,"dur":6,"clip":"07_nasa-view/Tracking_system_rig_dark_room_202607101936.mp4","file":"assets/07_nasa-view/Tracking_system_rig_dark_room_202607101936.mp4","in":3.88,"text":"But in the end, it only recorded its own decay.","kw":["only","recorded","decay"],"ch":7},{"t":92.88,"dur":3.28,"clip":"07_nasa-view/AI_reconstruction_1985_video_202607101858.mp4","file":"assets/07_nasa-view/AI_reconstruction_1985_video_202607101858.mp4","in":3.08,"text":"Only the machines remained.","kw":["only","machines","remained"],"ch":7},{"t":100.6,"dur":6.56,"clip":"07_nasa-view/Computer_monitor_showing_critica…_202607101936.mp4","file":"assets/07_nasa-view/Computer_monitor_showing_critica…_202607101936.mp4","in":0,"text":"But this was a system that no one truly understood.","kw":["system","truly","understood"],"ch":7},{"t":113.57,"dur":4,"clip":"07_nasa-view/Tracking_system_rig_dark_room_202607101936.mp4","file":"assets/07_nasa-view/Tracking_system_rig_dark_room_202607101936.mp4","in":0,"text":"It was a system designed to track everything.","kw":["system","designed","track","everything"],"ch":7},{"t":120.33,"dur":5,"clip":"07_nasa-view/Researcher's_eyes_reflected_HMD_202607101936.mp4","file":"assets/07_nasa-view/Researcher's_eyes_reflected_HMD_202607101936.mp4","in":4.88,"text":"We created a new kind of void, a space where everything could be programmed.","kw":["created","kind","void","space","where","everything","could","programmed"],"ch":7},{"t":127.86,"dur":4,"clip":"07_nasa-view/Military_simulation_room_calibra…_202607101936.mp4","file":"assets/07_nasa-view/Military_simulation_room_calibra…_202607101936.mp4","in":0,"text":"This was the moment where humans began to slip away.","kw":["moment","where","humans","began","slip","away"],"ch":7},{"t":134.39,"dur":3.8,"clip":"07_nasa-view/Woman_remote_operator_in_space_202607101858.mp4","file":"assets/07_nasa-view/Woman_remote_operator_in_space_202607101858.mp4","in":0,"text":"In 1985, we began to inhabit the screen.","kw":["began","inhabit","screen"],"ch":7},{"t":142.95,"dur":5,"clip":"07_nasa-view/AI-generated_NASA_lab_reconstruc…_202607101858.mp4","file":"assets/07_nasa-view/AI-generated_NASA_lab_reconstruc…_202607101858.mp4","in":0,"text":"In 1985, we believed we were building a new world.","kw":["believed","building","world"],"ch":7},{"t":154.95,"dur":4,"clip":"07_nasa-view/NASA_DataGlove_flexing_hand_202607101936.mp4","file":"assets/07_nasa-view/NASA_DataGlove_flexing_hand_202607101936.mp4","in":3.88,"text":"A promise of total control over a virtual world.","kw":["promise","total","control","over","virtual","world"],"ch":7},{"t":161.63,"dur":4,"clip":"07_nasa-view/AI_operator_interacting_with_key…_202607101858.mp4","file":"assets/07_nasa-view/AI_operator_interacting_with_key…_202607101858.mp4","in":0,"text":"In 1985, a new world was born.","kw":["world","born"],"ch":7},{"t":168.36,"dur":4,"clip":"07_nasa-view/AI-generated_historical_reconstr…_202607101858_2.mp4","file":"assets/07_nasa-view/AI-generated_historical_reconstr…_202607101858_2.mp4","in":5.88,"text":"creating an abstract world forever out of reach.","kw":["creating","abstract","world","forever","reach"],"ch":7},{"t":175.45,"dur":3,"clip":"07_nasa-view/Woman_remote_operator_in_space_202607101858.mp4","file":"assets/07_nasa-view/Woman_remote_operator_in_space_202607101858.mp4","in":6.88,"text":"to create a new, optimistic world.","kw":["create","optimistic","world"],"ch":7},{"t":179.7,"dur":5,"clip":"07_nasa-view/AI_technicians_calibrating_magne…_202607101858.mp4","file":"assets/07_nasa-view/AI_technicians_calibrating_magne…_202607101858.mp4","in":0,"text":"I'm marking the telemetry points now.","kw":["marking","telemetry","points"],"ch":7},{"t":187.28,"dur":4,"clip":"07_nasa-view/NASA_DataGlove_flexing_hand_202607101936.mp4","file":"assets/07_nasa-view/NASA_DataGlove_flexing_hand_202607101936.mp4","in":0,"text":"This was the beginning of a new way of seeing.","kw":["beginning","seeing"],"ch":7}],"duck":[[0,10.01,0.55],[10.26,20.51,0.28],[23.06,28.31,0.28],[32.31,41.56,0.28],[45.46,51.71,0.28],[54.09,64.34,0.28],[77.94,82.23,0.28],[85.05,91.3,0.28],[92.88,96.41,0.28],[100.6,107.41,0.28],[113.57,117.82,0.28],[120.33,125.58,0.28],[127.86,132.11,0.28],[134.39,138.44,0.28],[142.95,148.2,0.28],[154.95,159.2,0.28],[161.63,165.88,0.28],[168.36,172.61,0.28],[175.45,178.7,0.28],[179.7,184.95,0.28],[187.28,191.53,0.28]],"coverage":0.791,"used":34,"pool":43,"speech":0.546,"eras":[7],"filmName":"SWEEP 21 FILM ch7"}