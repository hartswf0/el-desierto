101944.mp4","in":0,"text":"But then, a strange kind of optical illusion took hold.","kw":["then","strange","kind","optical","illusion","took","hold"],"ch":14},{"t":77.5,"dur":5.88,"clip":"14_vision-pro/Person_wearing_VR_headset_sofa_202607101944.mp4","file":"assets/14_vision-pro/Person_wearing_VR_headset_sofa_202607101944.mp4","in":0,"text":"But this was an illusion.","kw":["illusion"],"ch":14},{"t":85.1,"dur":8.52,"clip":"14_vision-pro/AI_user_looking_at_dinosaur_202607101906.mp4","file":"assets/14_vision-pro/AI_user_looking_at_dinosaur_202607101906.mp4","in":0,"text":"In July 2015, somethingishing changes.","kw":["july","somethingishing","changes"],"ch":14},{"t":96.34,"dur":5.12,"clip":"14_vision-pro/AI-generated_historical_reconstr…_202607101906_2.mp4","file":"assets/14_vision-pro/AI-generated_historical_reconstr…_202607101906_2.mp4","in":20.84,"text":"I'm a transfer to Egypt.","kw":["transfer","egypt"],"ch":14},{"t":106.51,"dur":7,"clip":"14_vision-pro/Retail_staff_measuring_headset_fit_202607101906.mp4","file":"assets/14_vision-pro/Retail_staff_measuring_headset_fit_202607101906.mp4","in":0,"text":"Beep beep beep.","kw":["beep"],"ch":14},{"t":114.58,"dur":5,"clip":"14_vision-pro/Person's_face_obscured_spatial_c…_202607101944.mp4","file":"assets/14_vision-pro/Person's_face_obscured_spatial_c…_202607101944.mp4","in":4.88,"text":"We began to believe that the projections were more real than we were.","kw":["began","believe","projections","more","real","than"],"ch":14},{"t":125.5,"dur":4.56,"clip":"14_vision-pro/AI-generated_historical_reconstr…_202607101906.mp4","file":"assets/14_vision-pro/AI-generated_historical_reconstr…_202607101906.mp4","in":5.16,"text":"controlled. But in pursuit of connection, we had never been more alone.","kw":["controlled","pursuit","connection","never","more","alone"],"ch":14},{"t":138.84,"dur":4,"clip":"14_vision-pro/Curtis_montage_room_dissolving_n…_202607101944.mp4","file":"assets/14_vision-pro/Curtis_montage_room_dissolving_n…_202607101944.mp4","in":5.88,"text":"And behind it, we were still all alone.","kw":["behind","still","alone"],"ch":14},{"t":145.49,"dur":2.28,"clip":"14_vision-pro/Empty_room_digital_interface_win…_202607101944.mp4","file":"assets/14_vision-pro/Empty_room_digital_interface_win…_202607101944.mp4","in":7.12,"text":"behind a cold, clinical ghost.","kw":["behind","cold","clinical","ghost"],"ch":14},{"t":149.52,"dur":3,"clip":"14_vision-pro/Platform_dashboard_displaying_an…_202607101944.mp4","file":"assets/14_vision-pro/Platform_dashboard_displaying_an…_202607101944.mp4","in":6.64,"text":"This was the cold clinical illusion of total control.","kw":["cold","clinical","illusion","total","control"],"ch":14},{"t":155.44,"dur":4.4,"clip":"14_vision-pro/Employee_cleaning_VR_headset_202607101944.mp4","file":"assets/14_vision-pro/Employee_cleaning_VR_headset_202607101944.mp4","in":5.48,"text":"But to maintain that illusion requires a quiet and endless devotion.","kw":["maintain","illusion","requires","quiet","endless","devotion"],"ch":14},{"t":162.23,"dur":3.92,"clip":"14_vision-pro/White_battery_cable_on_floor_202607101944.mp4","file":"assets/14_vision-pro/White_battery_cable_on_floor_202607101944.mp4","in":0,"text":"But this was illusion.","kw":["illusion"],"ch":14},{"t":167.76,"dur":4,"clip":"14_vision-pro/Curtis_montage_room_dissolving_n…_202607101944.mp4","file":"assets/14_vision-pro/Curtis_montage_room_dissolving_n…_202607101944.mp4","in":0,"text":"We were promised a world of infinite connection.","kw":["promised","world","infinite","connection"],"ch":14},{"t":173.54,"dur":2.12,"clip":"14_vision-pro/Person_wearing_VR_headset_sofa_202607101944.mp4","file":"assets/14_vision-pro/Person_wearing_VR_headset_sofa_202607101944.mp4","in":5.76,"text":"Almost no one could see the real world anymore.","kw":["almost","could","real","world","anymore"],"ch":14},{"t":178.38,"dur":1.6,"clip":"14_vision-pro/VR_headset_close-up_polished_202607101944.mp4","file":"assets/14_vision-pro/VR_headset_close-up_polished_202607101944.mp4","in":7.76,"text":"the world changed around you.","kw":["world","changed","around"],"ch":14},{"t":183.06,"dur":4.72,"clip":"14_vision-pro/White_battery_cable_on_floor_202607101944.mp4","file":"assets/14_vision-pro/White_battery_cable_on_floor_202607101944.mp4","in":3.8,"text":"A tiny part of a vast in-system of control.","kw":["tiny","part","vast","system","control"],"ch":14},{"t":189.8,"dur":3.12,"clip":"14_vision-pro/Platform_dashboard_displaying_an…_202607101944.mp4","file":"assets/14_vision-pro/Platform_dashboard_displaying_an…_202607101944.mp4","in":3.52,"text":"but the system was already charting our every desire.","kw":["system","already","charting","every","desire"],"ch":14},{"t":195.09,"dur":4,"clip":"14_vision-pro/Biometric_mapping_visualization_…_202607101944.mp4","file":"assets/14_vision-pro/Biometric_mapping_visualization_…_202607101944.mp4","in":4.88,"text":"but it only taught the machines how to see us.","kw":["only","taught","machines"],"ch":14},{"t":201,"dur":3.08,"clip":"14_vision-pro/Glowing_blue_data_center_corridor_202607101944.mp4","file":"assets/14_vision-pro/Glowing_blue_data_center_corridor_202607101944.mp4","in":6.8,"text":"we only created a mirror of our own illusions.","kw":["only","created","mirror","illusions"],"ch":14},{"t":207.29,"dur":3.16,"clip":"14_vision-pro/AI_reconstructs_man_at_desk_202607101906.mp4","file":"assets/14_vision-pro/AI_reconstructs_man_at_desk_202607101906.mp4","in":5.16,"text":"captured by a cold, institutional precision.","kw":["captured","cold","institutional","precision"],"ch":14},{"t":215.31,"dur":3,"clip":"14_vision-pro/Tech_executive_presenting_spatia…_202607101944.mp4","file":"assets/14_vision-pro/Tech_executive_presenting_spatia…_202607101944.mp4","in":5.88,"text":"But what happens when you cannot tell the difference?","kw":["what","happens","when","cannot","tell","difference"],"ch":14},{"t":219.21,"dur":2,"clip":"14_vision-pro/Curtis_montage_room_dissolving_n…_202607101944.mp4","file":"assets/14_vision-pro/Curtis_montage_room_dissolving_n…_202607101944.mp4","in":3.88,"text":"But it was just a screen.","kw":["just","screen"],"ch":14},{"t":222.94,"dur":2.44,"clip":"14_vision-pro/AI_reconstructs_man_at_desk_202607101906.mp4","file":"assets/14_vision-pro/AI_reconstructs_man_at_desk_202607101906.mp4","in":8.32,"text":"The room was reconstructed.","kw":["room","reconstructed"],"ch":14}],"duck":[[0,10.01,0.55],[10.26,21.75,0.28],[24.4,32.65,0.28],[34.39,40.64,0.28],[42.09,45.34,0.28],[47.13,51.22,0.28],[52.47,58.32,0.28],[61.19,68.88,0.28],[71.44,76.69,0.28],[77.5,83.63,0.28],[85.1,93.87,0.28],[96.34,101.71,0.28],[106.51,113.76,0.28],[114.58,119.83,0.28],[125.5,130.31,0.28],[133.84,136.81,0.55],[138.84,143.09,0.28],[145.49,148.02,0.28],[149.52,152.77,0.28],[155.44,160.09,0.28],[162.23,166.4,0.28],[167.76,172.01,0.28],[173.54,175.91,0.28],[178.38,180.23,0.28],[183.06,188.03,0.28],[189.8,193.17,0.28],[195.09,199.34,0.28],[201,204.33,0.28],[207.29,210.7,0.28],[215.31,218.56,0.28],[219.21,221.46,0.28],[222.94,225.63,0.28]],"coverage":0.929,"used":39,"pool":42,"speech":0.603,"eras":[14],"filmName":"SWEEP 42 FILM ch14"}