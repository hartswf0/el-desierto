n":null},{"t":189.2,"len":0.92,"kind":"shot","clip":"14_vision-pro/AI-generated_historical_reconstr…_202607101906.mp4","file":"assets/14_vision-pro/AI-generated_historical_reconstr…_202607101906.mp4","in":5.38,"policy":"MUTE","ch":14,"func":"periphery","status":"reconstruction","still":false,"pid":"14_vision_pro_AI_generated_historical_reconstr_202607101906_mp4","pan":null},{"t":190.12,"len":3.39,"kind":"shot","clip":"14_vision-pro/Spatial_interface_demonstration_…_202607101944.mp4","file":"assets/14_vision-pro/Spatial_interface_demonstration_…_202607101944.mp4","in":2.65,"policy":"MUTE","ch":14,"func":"human","status":"documented","still":false,"pid":"14_vision_pro_Spatial_interface_demonstration_202607101944_mp4","pan":null,"ending":true}],"voice":[{"t":5.29,"dur":9,"clip":"01_3d-golden/Lion_leaps_toward_camera_202607101843.mp4","file":"assets/01_3d-golden/Lion_leaps_toward_camera_202607101843.mp4","in":0,"text":"We believed we could impose our own order on the world, but we forgot that some forces can never be contained.","kw":["believed","could","impose","order","world","forgot","some","forces"],"ch":1},{"t":20.34,"dur":6,"clip":"02_telesphere/Presenter_demonstrating_portable…_202607101849.mp4","file":"assets/02_telesphere/Presenter_demonstrating_portable…_202607101849.mp4","in":3.88,"text":"This is your own private theater, a truly personal cinema experience.","kw":["your","private","theater","truly","personal","cinema","experience"],"ch":2},{"t":32.51,"dur":6.6,"clip":"03_sensorama/AI_historical_reconstruction_Sen…_202607101851.mp4","file":"assets/03_sensorama/AI_historical_reconstruction_Sen…_202607101851.mp4","in":0,"text":"The Censorama offers a fully integrated experience, with simulated wind and aroma to enhance the illusion.","kw":["censorama","offers","fully","integrated","experience","simulated","wind","aroma"],"ch":3},{"t":46.44,"dur":10,"clip":"04_ultimate-display/Early_computer_graphics_wirefram…_202607101924.mp4","file":"assets/04_ultimate-display/Early_computer_graphics_wirefram…_202607101924.mp4","in":0,"text":"In the 1960s, a small group of engineers began to believe that they could contain the chaos of the world.","kw":["small","group","engineers","began","believe","could","contain","chaos"],"ch":4},{"t":60.09,"dur":6,"clip":"05_damocles/Test_subject_beneath_mechanical_arm_202607101926.mp4","file":"assets/05_damocles/Test_subject_beneath_mechanical_arm_202607101926.mp4","in":3.88,"text":"They wanted to map the human mind, to connect the brain directly to a digital world.","kw":["wanted","human","mind","connect","brain","directly","digital","world"],"ch":5},{"t":74.12,"dur":8.8,"clip":"06_public-grid/Person's_face_reflecting_television_202607101928.mp4","file":"assets/06_public-grid/Person's_face_reflecting_television_202607101928.mp4","in":0,"text":"But this was an illusion, a vast artificial dream projected directly into our minds.","kw":["illusion","vast","artificial","dream","projected","directly","minds"],"ch":6},{"t":87.86,"dur":9,"clip":"07_nasa-view/Hand_reaching_for_wireframe_object_202607101936.mp4","file":"assets/07_nasa-view/Hand_reaching_for_wireframe_object_202607101936.mp4","in":0,"text":"In 1985, we believed we could create a world of perfect order, but the machines only showed us our own failure.","kw":["believed","could","create","world","perfect","order","machines","only"],"ch":7},{"t":101.8,"dur":7,"clip":"08_vpl/People_wearing_HMDs_DataGloves_202607101938.mp4","file":"assets/08_vpl/People_wearing_HMDs_DataGloves_202607101938.mp4","in":0,"text":"In 1987, scientists believed they could create a new world, a shared space beyond physical reality.","kw":["scientists","believed","could","create","world","shared","space","beyond"],"ch":8},{"t":115.73,"dur":7.28,"clip":"09_arcade-era/AI_historical_reconstruction_VHS…_202607101900.mp4","file":"assets/09_arcade-era/AI_historical_reconstruction_VHS…_202607101900.mp4","in":0,"text":"They promised they escaped from reality, but they were trapped in a private world.","kw":["promised","escaped","reality","trapped","private","world"],"ch":9},{"t":129.94,"dur":9,"clip":"10_vr-winter/Hand_marking_liquidation_report_202607101941.mp4","file":"assets/10_vr-winter/Hand_marking_liquidation_report_202607101941.mp4","in":0,"text":"But the vision of a new reality was quickly deleted by the cold, hard logic of the balance sheet.","kw":["vision","reality","quickly","deleted","cold","hard","logic","balance"],"ch":10},{"t":143.21,"dur":9,"clip":"11_oculus/AI-generated_reconstruction_empt…_202607101902.mp4","file":"assets/11_oculus/AI-generated_reconstruction_empt…_202607101902.mp4","in":0,"text":"It was a new kind of collective power, but it would soon lead to a strange form of control.","kw":["kind","collective","power","would","soon","lead","strange","form"],"ch":11},{"t":156.87,"dur":7.68,"clip":"12_consumer-vr/Person_wearing_VR_headset_hits_202607101942.mp4","file":"assets/12_consumer-vr/Person_wearing_VR_headset_hits_202607101942.mp4","in":0,"text":"But this was a fantasy where the real world would soon intervene.","kw":["fantasy","where","real","world","would","soon","intervene"],"ch":12},{"t":171.08,"dur":7,"clip":"13_open-standard/Hands_passing_VR_trackers_202607101943.mp4","file":"assets/13_open-standard/Hands_passing_VR_trackers_202607101943.mp4","in":2.88,"text":"A retreat from the giant systems into a world they could build together.","kw":["retreat","giant","systems","world","could","build","together"],"ch":13},{"t":184.55,"dur":8,"clip":"14_vision-pro/Spatial_interface_demonstration_…_202607101944.mp4","file":"assets/14_vision-pro/Spatial_interface_demonstration_…_202607101944.mp4","in":0,"text":"This is the simplified world, where everything is tracked and perfectly connected.","kw":["simplified","world","where","everything","tracked","perfectly","connected"],"ch":14}],"duck":[[0,4.84,0.55],[5.29,14.54,0.28],[13.82,18.66,0.55],[20.34,26.59,0.28],[27.64,32.48,0.55],[32.51,39.36,0.28],[41.47,46.31,0.55],[46.44,56