mp4","pan":null},{"t":146.75,"len":3.95,"kind":"shot","clip":"BOOTS/ch14_03_chapter_14.mp4","file":"BOOTS/ch14_03_chapter_14.mp4","in":0,"policy":"BOOT","ch":14,"func":"TITLE","status":"interstitial","still":false,"pid":"boot_ch14_03_chapter_14","pan":null,"boot":true},{"t":150.7,"len":7.34,"kind":"shot","clip":"14_vision-pro/Empty_room_digital_interface_win…_202607101944.mp4","file":"assets/14_vision-pro/Empty_room_digital_interface_win…_202607101944.mp4","in":0.96,"policy":"MUTE","ch":14,"func":"human","status":"documented","still":false,"pid":"14_vision_pro_Empty_room_digital_interface_win_202607101944_mp4","pan":null}],"voice":[{"t":4.1,"dur":9,"clip":"01_3d-golden/Lion_leaps_toward_camera_202607101843.mp4","file":"assets/01_3d-golden/Lion_leaps_toward_camera_202607101843.mp4","in":0,"text":"We believed we could impose our own order on the world, but we forgot that some forces can never be contained.","kw":["believed","could","impose","order","world","forgot","some","forces"],"ch":1},{"t":15.39,"dur":9.24,"clip":"02_telesphere/Mask_lowered_toward_face_202607101848.mp4","file":"assets/02_telesphere/Mask_lowered_toward_face_202607101848.mp4","in":0,"text":"But this was a new kind of dream where the machines did the feeling for us.","kw":["kind","dream","where","machines","feeling"],"ch":2},{"t":26.68,"dur":9,"clip":"03_sensorama/Close-up_archival_footage_advert…_202607101922.mp4","file":"assets/03_sensorama/Close-up_archival_footage_advert…_202607101922.mp4","in":0,"text":"In 1962 a new world was promised where technology would simulate reality itself.","kw":["world","promised","where","technology","would","simulate","reality","itself"],"ch":3},{"t":37.96,"dur":9,"clip":"04_ultimate-display/Hand_drawing_wireframe_rooms_cha…_202607101924.mp4","file":"assets/04_ultimate-display/Hand_drawing_wireframe_rooms_cha…_202607101924.mp4","in":0,"text":"We began to map the world, not as it was, but as a series of cold, predictable spaces.","kw":["began","world","series","cold","predictable","spaces"],"ch":4},{"t":49.78,"dur":6,"clip":"05_damocles/Test_subject_beneath_mechanical_arm_202607101926.mp4","file":"assets/05_damocles/Test_subject_beneath_mechanical_arm_202607101926.mp4","in":3.88,"text":"They wanted to map the human mind, to connect the brain directly to a digital world.","kw":["wanted","human","mind","connect","brain","directly","digital","world"],"ch":5},{"t":60.54,"dur":8.8,"clip":"06_public-grid/Person's_face_reflecting_television_202607101928.mp4","file":"assets/06_public-grid/Person's_face_reflecting_television_202607101928.mp4","in":0,"text":"But this was an illusion, a vast artificial dream projected directly into our minds.","kw":["illusion","vast","artificial","dream","projected","directly","minds"],"ch":6},{"t":71.83,"dur":10,"clip":"07_nasa-view/Operator_wearing_VIEW_headset_202607101936.mp4","file":"assets/07_nasa-view/Operator_wearing_VIEW_headset_202607101936.mp4","in":0,"text":"In the 1980s we began to build a new world but we did not realize that it would leave us completely alone.","kw":["began","build","world","realize","would","leave","completely","alone"],"ch":7},{"t":83.12,"dur":7.04,"clip":"08_vpl/Tech_magazine_cover_1987_202607101938.mp4","file":"assets/08_vpl/Tech_magazine_cover_1987_202607101938.mp4","in":0,"text":"In 1987, we were promised an escape, a digital world where reality itself could be rewritten.","kw":["promised","escape","digital","world","where","reality","itself","could"],"ch":8},{"t":94.41,"dur":8.64,"clip":"09_arcade-era/VR_simulation_ride_amusement_park_202607101939.mp4","file":"assets/09_arcade-era/VR_simulation_ride_amusement_park_202607101939.mp4","in":0,"text":"But this was a new kind of escape, where reality itself was managed by machines.","kw":["kind","escape","where","reality","itself","managed","machines"],"ch":9},{"t":105.69,"dur":9,"clip":"10_vr-winter/Hand_marking_liquidation_report_202607101941.mp4","file":"assets/10_vr-winter/Hand_marking_liquidation_report_202607101941.mp4","in":0,"text":"But the vision of a new reality was quickly deleted by the cold, hard logic of the balance sheet.","kw":["vision","reality","quickly","deleted","cold","hard","logic","balance"],"ch":10},{"t":116.98,"dur":9,"clip":"11_oculus/AI-generated_reconstruction_empt…_202607101902.mp4","file":"assets/11_oculus/AI-generated_reconstruction_empt…_202607101902.mp4","in":0,"text":"It was a new kind of collective power, but it would soon lead to a strange form of control.","kw":["kind","collective","power","would","soon","lead","strange","form"],"ch":11},{"t":128.55,"dur":7.68,"clip":"12_consumer-vr/Person_wearing_VR_headset_hits_202607101942.mp4","file":"assets/12_consumer-vr/Person_wearing_VR_headset_hits_202607101942.mp4","in":0,"text":"But this was a fantasy where the real world would soon intervene.","kw":["fantasy","where","real","world","would","soon","intervene"],"ch":12},{"t":139.56,"dur":7,"clip":"13_open-standard/Hands_passing_VR_trackers_202607101943.mp4","file":"assets/13_open-standard/Hands_passing_VR_trackers_202607101943.mp4","in":2.88,"text":"A retreat from the giant systems into a world they could build together.","kw":["retreat","giant","systems","world","could","build","together"],"ch":13},{"t":150.85,"dur":8,"clip":"14_vision-pro/Spatial_interface_demonstration_…_202607101944.mp4","file":"assets/14_vision-pro/Spatial_interface_demonstration_…_202607101944.mp4","in":0,"text":"This is the simplified world, where everything is tracked and perfectly connected.","kw":["simplified","world","where","everything","tracked","perfectly","connected"],"ch":14}],"duck":[[0,3.95,0.55],[4.1,13.35,0.28],[11.29,15.24,0.55],[15.39,24.88,0.28],[22.58,26.53,0.55],[26.68,35.93,0.28],[33.86,37.81,0.55],[37.96,47.21,0.28],[45.15,49.1,0.55],[49.78,56.03,0.28],[56.44,60.39,0.55],[60.54,69.59,0.28],[67.73,71.68,0.55],[71.83,82.08,0.28],[79.02,82.97,0.55],[83.12,90.41,0.28],[90.31,94.26,0.55],[94.41,103.3,0.28],[101.59,105.54,0.55],[105.69,114.94,0.28],[112.88,116.83,0.