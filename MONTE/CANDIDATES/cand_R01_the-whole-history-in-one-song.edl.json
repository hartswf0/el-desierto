607101944.mp4","file":"assets/14_vision-pro/Empty_room_digital_interface_win…_202607101944.mp4","in":3.42,"policy":"MUTE","ch":14,"func":"human","status":"documented","still":false,"pid":"14_vision_pro_Empty_room_digital_interface_win_202607101944_mp4","pan":null},{"t":221.05,"len":6.32,"kind":"shot","clip":"14_vision-pro/Spatial_interface_demonstration_…_202607101944.mp4","file":"assets/14_vision-pro/Spatial_interface_demonstration_…_202607101944.mp4","in":1.13,"policy":"MUTE","ch":14,"func":"human","status":"documented","still":false,"pid":"14_vision_pro_Spatial_interface_demonstration_202607101944_mp4","pan":null,"ending":true}],"voice":[{"t":6.41,"dur":9,"clip":"01_3d-golden/Lion_leaps_toward_camera_202607101843.mp4","file":"assets/01_3d-golden/Lion_leaps_toward_camera_202607101843.mp4","in":0,"text":"We believed we could impose our own order on the world, but we forgot that some forces can never be contained.","kw":["believed","could","impose","order","world","forgot","some","forces"],"ch":1},{"t":23.96,"dur":4.76,"clip":"02_telesphere/Presenter_demonstrates_cinema_he…_202607101850.mp4","file":"assets/02_telesphere/Presenter_demonstrates_cinema_he…_202607101850.mp4","in":3.12,"text":"Notice the dual eyepieces for individual viewing, a private theater that travels everywhere with you.","kw":["notice","dual","eyepieces","individual","viewing","private","theater","travels"],"ch":2},{"t":38.27,"dur":10,"clip":"03_sensorama/Fans_spinning_in_dark_space_202607101922.mp4","file":"assets/03_sensorama/Fans_spinning_in_dark_space_202607101922.mp4","in":0,"text":"It was a device designed to replace reality by manipulating the very air we breathe.","kw":["device","designed","replace","reality","manipulating","very","breathe"],"ch":3},{"t":55.91,"dur":9,"clip":"04_ultimate-display/Hand_drawing_wireframe_rooms_cha…_202607101924.mp4","file":"assets/04_ultimate-display/Hand_drawing_wireframe_rooms_cha…_202607101924.mp4","in":0,"text":"We began to map the world, not as it was, but as a series of cold, predictable spaces.","kw":["began","world","series","cold","predictable","spaces"],"ch":4},{"t":72.91,"dur":6,"clip":"05_damocles/Test_subject_beneath_mechanical_arm_202607101926.mp4","file":"assets/05_damocles/Test_subject_beneath_mechanical_arm_202607101926.mp4","in":3.88,"text":"They wanted to map the human mind, to connect the brain directly to a digital world.","kw":["wanted","human","mind","connect","brain","directly","digital","world"],"ch":5},{"t":87.21,"dur":8.8,"clip":"06_public-grid/Person's_face_reflecting_television_202607101928.mp4","file":"assets/06_public-grid/Person's_face_reflecting_television_202607101928.mp4","in":0,"text":"But this was an illusion, a vast artificial dream projected directly into our minds.","kw":["illusion","vast","artificial","dream","projected","directly","minds"],"ch":6},{"t":103.65,"dur":10,"clip":"07_nasa-view/Operator_wearing_VIEW_headset_202607101936.mp4","file":"assets/07_nasa-view/Operator_wearing_VIEW_headset_202607101936.mp4","in":0,"text":"In the 1980s we began to build a new world but we did not realize that it would leave us completely alone.","kw":["began","build","world","realize","would","leave","completely","alone"],"ch":7},{"t":120.65,"dur":7.04,"clip":"08_vpl/Tech_magazine_cover_1987_202607101938.mp4","file":"assets/08_vpl/Tech_magazine_cover_1987_202607101938.mp4","in":0,"text":"In 1987, we were promised an escape, a digital world where reality itself could be rewritten.","kw":["promised","escape","digital","world","where","reality","itself","could"],"ch":8},{"t":136.81,"dur":8.64,"clip":"09_arcade-era/VR_simulation_ride_amusement_park_202607101939.mp4","file":"assets/09_arcade-era/VR_simulation_ride_amusement_park_202607101939.mp4","in":0,"text":"But this was a new kind of escape, where reality itself was managed by machines.","kw":["kind","escape","where","reality","itself","managed","machines"],"ch":9},{"t":152.04,"dur":9,"clip":"10_vr-winter/Hand_marking_liquidation_report_202607101941.mp4","file":"assets/10_vr-winter/Hand_marking_liquidation_report_202607101941.mp4","in":0,"text":"But the vision of a new reality was quickly deleted by the cold, hard logic of the balance sheet.","kw":["vision","reality","quickly","deleted","cold","hard","logic","balance"],"ch":10},{"t":169.51,"dur":9,"clip":"11_oculus/AI-generated_reconstruction_empt…_202607101902.mp4","file":"assets/11_oculus/AI-generated_reconstruction_empt…_202607101902.mp4","in":0,"text":"It was a new kind of collective power, but it would soon lead to a strange form of control.","kw":["kind","collective","power","would","soon","lead","strange","form"],"ch":11},{"t":184.74,"dur":7.68,"clip":"12_consumer-vr/Person_wearing_VR_headset_hits_202607101942.mp4","file":"assets/12_consumer-vr/Person_wearing_VR_headset_hits_202607101942.mp4","in":0,"text":"But this was a fantasy where the real world would soon intervene.","kw":["fantasy","where","real","world","would","soon","intervene"],"ch":12},{"t":202.11,"dur":7,"clip":"13_open-standard/Hands_passing_VR_trackers_202607101943.mp4","file":"assets/13_open-standard/Hands_passing_VR_trackers_202607101943.mp4","in":2.88,"text":"A retreat from the giant systems into a world they could build together.","kw":["retreat","giant","systems","world","could","build","together"],"ch":13},{"t":217.99,"dur":8,"clip":"14_vision-pro/Spatial_interface_demonstration_…_202607101944.mp4","file":"assets/14_vision-pro/Spatial_interface_demonstration_…_202607101944.mp4","in":0,"text":"This is the simplified world, where everything is tracked and perfectly connected.","kw":["simplified","world","where","everything","tracked","perfectly","connected"],"ch":14}],"duck":[[0,5.68,0.55],[6.41,15.66,0.28],[16.24,21.92,0.55],[23.96,28.97,0.28],[32.48,38.16,0.55],[38.27,48.52,0.28],[48.72,54.4,0.55],[55.91,65.16,0.28],[64.96,70.64,0.55],[72.91,79.16,0.28],[81.2,86.88,0.55],[87.21,96.26,0.28],[97.44,103.12,0.55],[103.65,113.9,0.28],[113.69,119.37,0.55],[120.65,127.94,0.28],[129.93